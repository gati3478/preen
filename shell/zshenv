# Runs for EVERY zsh — login, interactive, scripts, `zsh -c`. Anything slow
# here multiplies across every subshell.

typeset -U path PATH             # every later prepend is idempotent
# User-local and cargo binaries for every shell, build scripts and hooks
# included; cargo guarded so removing rust cannot break every shell.
path=("$HOME/.local/bin" $path)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
# For every zsh that reads this file, each only where it exists: anything
# the Dock starts, kitty included, runs on /usr/bin:/bin:/usr/sbin:/sbin,
# and the login files add these only after the editor below is chosen.
# Appended, so where no login file has run, the system's tools still come
# first.
path+=(/opt/homebrew/bin(N-/) /usr/local/bin(N-/))

# ── Editor ─────────────────────────────────────────────────
# Here, not .zshrc: `git commit`, `git rebase -i` and visudo read $EDITOR
# from whatever spawned them. --wait is load-bearing — without it git sees
# an empty buffer and aborts. The fallback is nano, deliberately not vi: the
# headless case must not land in modal editing (the non-modal criterion in
# preferences.md). Guarded on the binary, so a machine without Zed degrades
# instead of failing.
# ⚠️ On THIS machine `nano` is pico — /usr/bin/nano is a symlink to
# /usr/bin/pico and no real nano is installed — so the branch lands in an
# editor with no rc file, and the box's nano taste cannot follow it here.
# A recorded ceiling, not drift: preferences.md, `editor_env / mac_nano_is_pico`.
if [ -n "$SSH_CONNECTION" ] || ! command -v zed >/dev/null 2>&1; then
  export EDITOR='nano'
else
  export EDITOR='zed --wait'
fi
export VISUAL="$EDITOR"

# ── ripgrep ────────────────────────────────────────────────
# rg reads a config only when this names one. Here because rg's callers —
# editor searches, scripts, agent tool calls — are not interactive shells,
# and the scope agreement (--hidden, like GLOB_DOTS and fd) is for all of
# them. Flags on the command line still override.
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

# ── SSH agent ──────────────────────────────────────────────
# Proton Pass's agent, at a fixed path. ssh reaches it through IdentityAgent
# in ~/.ssh/config; this export is for everything else that reads the
# variable — ssh-add -l, scripts, agent-aware tools. Here, not .zprofile:
# hooks and scripts read it from whatever spawned them, and the guard is one
# stat. Guarded on the socket so a machine without Pass keeps the agent it
# has. The path is spelled twice because the preference check reads text.
if [ -S "$HOME/.ssh/proton-pass-ssh-agent.sock" ]; then
  export SSH_AUTH_SOCK="$HOME/.ssh/proton-pass-ssh-agent.sock"
fi

# Machine-specific overrides; absent on a fresh clone.
[ -f "$HOME/.zshenv.local" ] && source "$HOME/.zshenv.local"
