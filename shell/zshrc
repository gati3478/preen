# Interactive shells only. PATH and login-only setup live in .zshenv and
# .zprofile.

# ── tmux (SSH only — Kitty is primary locally) ───────────
# Not `exec tmux`: when tmux cannot start — a TERM the host's terminfo does
# not know, and it exits "open terminal failed" — exec would end the login
# with no shell at all. This form falls through to a plain shell and says
# so. `-A` attaches to the session if it exists, so a drop reconnects.
if command -v tmux &>/dev/null && [[ -z "$TMUX" && $- == *i* && -n "$SSH_CONNECTION" ]]; then
  if tmux new-session -A -s remote; then
    exit
  fi
  print -u2 "tmux would not start; continuing in a plain shell."
fi

# ── Shell Options ────────────────────────────────────────
# EXTENDED_GLOB first: the Completion block's (#q…) staleness check is
# extended-glob syntax and reads as literal text without it, so the cached
# compinit path would silently never run.
setopt EXTENDED_GLOB
setopt AUTO_CD
setopt CORRECT
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP
setopt GLOB_DOTS
setopt NO_CLOBBER                # `>|` is the deliberate override
setopt ALWAYS_TO_END             # completing mid-word parks the cursor at word end
setopt COMPLETE_IN_WORD          # …and completes from both ends
setopt NO_FLOW_CONTROL           # Ctrl+S no longer wedges the terminal
setopt NUMERIC_GLOB_SORT         # file2 before file10
CORRECT_IGNORE='_*'              # never "correct" a typo to a completion function
REPORTTIME=10                    # CPU seconds, so a network wait never reports
WORDCHARS=''                     # every non-alphanumeric is a word boundary — native motion

# ── History ──────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE         # a leading space keeps a command out of the record
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY               # a `!!` expansion is previewed, never run blind
setopt EXTENDED_HISTORY
setopt HIST_FIND_NO_DUPS
setopt HIST_FCNTL_LOCK           # many concurrent shells write the shared file
setopt HIST_SAVE_NO_DUPS         # dedupe what SHARE_HISTORY imports from other shells

# ── Key Bindings ─────────────────────────────────────────
# Emacs by declaration, before any binding: zsh picks viins whenever
# $EDITOR contains "vi", and a binding made under viins is lost when the
# keymap switches.
bindkey -e

# Prefix search: history-beginning-search matches the line up to the
# cursor (history-search-backward matched the first word only), and the
# -end variants park the cursor at end of line.
autoload -Uz history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end  history-search-end
bindkey '^[[A' history-beginning-search-backward-end
bindkey '^[[B' history-beginning-search-forward-end
# The same keys in application-cursor mode — what a TUI that died without
# resetting the terminal leaves behind, and where /etc/zshrc binds the
# first-word search this block replaces.
bindkey '^[OA' history-beginning-search-backward-end
bindkey '^[OB' history-beginning-search-forward-end

# Native motion in the encodings kitty sends at a zsh prompt (terminfo for
# the option+ keys; its keyboard-protocol page for the rest — CSI 1;<1+bits>,
# super = 8). zsh's defaults stop at the bare arrows, and /etc/zshrc binds
# Home/End only in the application-mode form zsh never asks for. That pair
# and fn+delete are pinned here as well, so the taste does not depend on a
# system file.
bindkey '^[[1;3D' backward-word       # option+left
bindkey '^[[1;3C' forward-word        # option+right
bindkey '^[[3;3~' kill-word           # option+fn+delete (option+delete is bound by default)
bindkey '^[[H' beginning-of-line      # Home
bindkey '^[[F' end-of-line            # End
bindkey '^[OH' beginning-of-line      # Home, application mode
bindkey '^[OF' end-of-line            # End, application mode
bindkey '^[[1;9D' beginning-of-line   # cmd+left
bindkey '^[[1;9C' end-of-line         # cmd+right
bindkey '^[[3~' delete-char           # fn+delete

# Shift+Tab walks the completion menu backwards, in both keymaps; the
# menuselect keymap only exists once complist is loaded.
zmodload zsh/complist
bindkey '^[[Z' reverse-menu-complete
bindkey -M menuselect '^[[Z' reverse-menu-complete

zle_highlight=('paste:none')     # pasted text renders plain, not standout

# Ctrl+X Ctrl+E edits the buffer in $EDITOR. Creates a widget: keep above
# the z-sy-h source line.
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# ── Completion ───────────────────────────────────────────
fpath=(~/.docker/completions $fpath)  # Docker Desktop ships its completion here
autoload -Uz compinit
# Versioned dump: `compinit -C` skips the staleness check, so an unversioned
# dump serves broken completions after a zsh upgrade. Rebuilt when older
# than a day, else the cached path (the saving is noise — traps.md).
ZCOMPDUMP="$HOME/.zcompdump-$ZSH_VERSION"
if [[ -n $ZCOMPDUMP(#qN.mh+24) ]]; then
  compinit -d "$ZCOMPDUMP"
else
  compinit -C -d "$ZCOMPDUMP"
fi
zstyle ':completion:*' menu select
# Case-insensitive; failing that, a fragment of each segment (`f.b` reaches
# foo.bar) — specs are tried in turn, so the second repeats the first.
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'm:{a-zA-Z}={A-Za-z} r:|[._-]=* r:|=*'
zstyle ':completion:*' list-dirs-first true
zstyle ':completion:*' squeeze-slashes true        # `foo//bar` is one path
zstyle ':completion:*' accept-exact-dirs true      # an existing directory prefix is not re-scanned
zstyle ':completion:*' select-prompt '%SScrolling active: current selection at %p%s'
# Colours live on the zstyle, not in an exported LS_COLORS, which would
# override eza's richer built-ins.
zstyle ':completion:*' list-colors 'di=01;34:ln=01;36:so=01;35:pi=33:ex=01;32:bd=01;33:cd=01;33:su=31:sg=31:tw=01;34:ow=01;34'
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%B%d%b'
zstyle ':completion:*:warnings' format 'no matches: %d'
zstyle ':completion:*' rehash true                 # a freshly installed command completes at once

# ── ssh/scp completion: offer hosts, not macOS service accounts ──────────
# Two completers contribute candidates: the user database (mostly macOS
# daemon accounts — excluded) and hosts, taken from ~/.ssh/config and the
# config.local it includes rather than known_hosts, whose entries are hashed
# and include every host visited once. The numbers are in preferences.md
# § Interaction. Through cat: awk stops at the first file it cannot open.
zstyle ':completion:*:*:*:users' ignored-patterns '_*' daemon nobody root
_ssh_config_hosts=(${(f)"$(cat ~/.ssh/config ~/.ssh/config.local 2>/dev/null | awk '/^[[:space:]]*[Hh]ost[[:space:]]/{for(i=2;i<=NF;i++) if ($i !~ /[*?!]/) print $i}')"})
zstyle ':completion:*:(ssh|scp|sftp|rsync|mosh|ssh-copy-id):*' hosts $_ssh_config_hosts

# ── Help ─────────────────────────────────────────────────
# Esc-h opens the manual for the command under the cursor, subcommand-aware.
# zsh ships run-help as an alias to plain man, which would shadow the
# autoloaded function that knows about subcommands. Renders through
# MANPAGER below.
unalias run-help 2>/dev/null
autoload -Uz run-help run-help-git run-help-sudo run-help-openssl

# ── Runtimes: node + python (mise) ───────────────────────
# One binary, one config, per-directory versions; replaced pyenv and nvm.
# SDKMAN and jset stay: mise would fight the Homebrew temurin casks, and
# jset guards against java_home's silent fallback.
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
  # Its precmd hook spawns `mise hook-env` on most prompts (the cost is in
  # preferences.md § Shell) and its chpwd_only knob is inert, so the hook is
  # cut by hand. The chpwd hook stays: a directory's tool set still switches
  # on cd, and a config edited in place applies on the next one (`cd .`).
  add-zsh-hook -d precmd _mise_hook_precmd
fi

# ── Java ─────────────────────────────────────────────────
# The default JDK is set per login in .zprofile; `jset N` switches at runtime.
jset() {
  local v="${1:?usage: jset <java-version>}"
  local home actual
  home="$(/usr/libexec/java_home -v "$v" 2>/dev/null)" || {
    print -u2 "jset: no JDK matching '$v' (try '/usr/libexec/java_home -V')"
    return 1
  }
  # java_home falls back to the newest JDK on a non-matching version, exit 0.
  actual="$(awk -F'"' '/^JAVA_VERSION=/{print $2}' "$home/release" 2>/dev/null)"
  if [[ "${v%%.*}" != "${actual%%.*}" ]]; then
    print -u2 "jset: '$v' not installed — java_home fell back to JDK ${actual:-?}"
    return 1
  fi
  # typeset -U dedupes identical entries only; drop the previous JDK's bin.
  if [[ -n "$JAVA_HOME" ]]; then
    path=("${(@)path:#$JAVA_HOME/bin}")
  fi
  export JAVA_HOME="$home"
  path=("$JAVA_HOME/bin" $path)
}

# ── SDKMAN (lazy) ────────────────────────────────────────
# Spring Boot CLI is on PATH via .zprofile; the init loads on first `sdk`.
export SDKMAN_DIR="$HOME/.sdkman"
sdk() {
  unfunction sdk
  source "$SDKMAN_DIR/bin/sdkman-init.sh"
  sdk "$@"
}

# ── Modern CLI Tools ─────────────────────────────────────
# fzf walks with fd so the finder searches what the repo considers real:
# .gitignore honoured, dotfiles in scope (the GLOB_DOTS agreement), .git
# never the answer. Deliberately unlike Zed's search.include_ignored — Zed
# never walks the heavy build directories; fzf here has no such list.
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
# A gate, not a mirror: the Ctrl+T widget empties FZF_DEFAULT_COMMAND and
# reads this alone, so unset it would run fzf's built-in walker.
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
# fzf's unconfigured base scheme is a 256-colour palette of its own, so
# silence does not ride the terminal's colours; zoxide's zi inherits this.
export FZF_DEFAULT_OPTS='--color=16'
# Previews answer "is this the one I mean?" before Enter; bat and eza both
# stay in-palette.
export FZF_CTRL_T_OPTS='--preview "bat --color=always --style=numbers --line-range=:200 {}"'
export FZF_ALT_C_OPTS='--preview "eza -1 --icons=auto --color=always --group-directories-first {}"'
# `**<TAB>` walks with fd through these hooks, which fzf looks up by name;
# without them its built-in walker ignores .gitignore. Same scope as the
# commands above, minus the file/dir split — path completion offers both.
_fzf_compgen_path() { fd --hidden --exclude .git . "$1"; }
_fzf_compgen_dir()  { fd --type d --hidden --exclude .git . "$1"; }
# `setopt zle` errors in a non-TTY interactive shell (Claude Code's
# `zsh -i -c`), so the widget init is guarded; the same guard makes
# `bindkey` under-report there — decisions.md, traps.md.
if [[ -t 1 ]]; then
  source <(fzf --zsh)
fi

# ── atuin: history as a queryable store ──────────────────
# After `fzf --zsh`: both bind Ctrl+R and the last binding wins.
#   Ctrl+R -> atuin  (history: scoped by directory, host, exit)
#   Ctrl+T -> fzf    (files)
#   Alt+C  -> fzf    (directories)
# --disable-up-arrow is required: atuin binds Up by default, which would
# replace the prefix search above. --disable-ai: a local-only history has no
# place for its default Atuin-AI `?` binding. The update check stays on —
# its notice is this surface's version-bump signal. The init also sets
# ZSH_AUTOSUGGEST_STRATEGY=(atuin), so the ghost text and Ctrl+R answer
# from one store; preen doctor pins it. Guarded on the TTY like fzf, and on
# the binary — a host without atuin keeps fzf's Ctrl+R.
if [[ -t 1 ]] && (( $+commands[atuin] )); then
  eval "$(atuin init zsh --disable-up-arrow --disable-ai)"
fi

# ── Pagers ───────────────────────────────────────────────
# man renders through bat, which carries --theme=ansi from its config, so
# manual pages inherit the terminal palette. Guarded: without bat this
# pager is a broken pipe, and man's own default still works.
if (( $+commands[bat] )); then
  export MANPAGER="sh -c 'col -bx | bat --language=man --plain'"
fi
# One lever for every pager — bat's less, delta's, a bare pipe: -i folds
# case until the pattern carries a capital, -R passes ANSI through on manual
# pipes, -F prints and exits when output fits one screen, --incsearch moves
# the match as you type. No --mouse: less grabbing the mouse kills
# copy-on-select inside a pager. -Q and --no-vbell carry NO_BEEP into the
# pager, where the bell actually fires — a wrapped search, the end of the
# file; -Q alone would trade the beep for a screen flash.
export LESS='-iRF --incsearch --wordwrap -Q --no-vbell'
# `< file` with no command runs $READNULLCMD, whose default is `more`. On
# macOS that is the same binary as less by hard link, but invoked under the
# other name it reads $MORE and ignores $LESS — so the one lever above
# reaches every pager except this one until it is named here.
export READNULLCMD=less

# ── Directories and listings ─────────────────────────────
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"        # z <partial-path> jumps by frecency
fi
# Every entry kitty-clickable — =auto is load-bearing, a bare --hyperlink
# eats the next positional — and directories first, as in the completion menu.
alias ls="eza --icons=auto --hyperlink=auto --group-directories-first"
alias ll="eza -la --icons=auto --git --hyperlink=auto --group-directories-first --time-style=long-iso"
alias lt="eza -T --icons=auto --git-ignore --hyperlink=auto --group-directories-first"
# rg's own --hyperlink-format=kitty (the ripgrep config) is the clickable grep;
# the hyperlinked-grep kitten it replaced retired 06-09-2026.
alias fp='kitten choose-files'   # keyboard file picker with previews

# ── Zsh Plugins ──────────────────────────────────────────
# Bind the suggestion widgets once, at the first prompt, instead of on
# every precmd — safe because nothing creates a widget after z-sy-h, which
# preen doctor asserts. Guarded so a fresh adopter without the formula gets a
# silent no-op, not an error on every shell.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && \
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# ── Starship Prompt ──────────────────────────────────────
# A host without it keeps whatever prompt its overlay sets.
if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi

# Machine-specific overrides; absent on a fresh clone.
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# ── zsh-syntax-highlighting — MUST BE LAST ───────────────
# Upstream: source after every `zle -N`, or a later widget stays unwrapped
# on the fallback path (traps.md). Nothing that creates a widget goes below.
# brackets colours by nesting level with the cursor's match marked; pattern
# paints one shape red before Enter. Every style is a named 4-bit colour,
# which preen doctor re-proves live.
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets pattern)
typeset -A ZSH_HIGHLIGHT_PATTERNS
ZSH_HIGHLIGHT_PATTERNS+=('rm -rf *' 'fg=white,bold,bg=red')
# Two candidates, first hit wins: the formula, then a clone — the form a
# host without root has to use. A host with neither keeps its login shell.
for _zsh_hl_dir in /opt/homebrew/share/zsh-syntax-highlighting ~/.zsh/zsh-syntax-highlighting; do
  if [ -f "$_zsh_hl_dir/zsh-syntax-highlighting.zsh" ]; then
    source "$_zsh_hl_dir/zsh-syntax-highlighting.zsh"
    break
  fi
done
unset _zsh_hl_dir
