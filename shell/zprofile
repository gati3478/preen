# Per LOGIN shell — on this machine per kitty tab, which spawns each tab as
# a login shell. Nothing here may run for every `zsh -c`; the multiplier is
# tabs.

# ── Homebrew (single source of truth) ─────────────────────
# Apple silicon's prefix, then Intel's; a machine with neither skips it.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [ -x "$_brew" ]; then
    eval "$("$_brew" shellenv)"
    break
  fi
done
unset _brew
export HOMEBREW_NO_ANALYTICS=1   # no telemetry — local-only, like atuin
export HOMEBREW_BAT=1            # brew cat renders through bat

# ── Java ──────────────────────────────────────────────────
# `jset N` (in .zshrc) switches at runtime, and guards the same trap by hand:
# java_home's documented default is to fall back to the newest JDK when no
# filter matches, exit 0 — so without -F, removing temurin-21 would silently
# make every login shell's JAVA_HOME JDK 25. Guarded on the RESULT, not just
# the flag: -F prints nothing on a miss, and the assignment alone would then
# prepend a bare "/bin" to PATH.
if _jh="$(/usr/libexec/java_home -F -v 21 2>/dev/null)"; then
  export JAVA_HOME="$_jh"
  path=("$JAVA_HOME/bin" $path)
fi
unset _jh

# ── Installer-added paths ─────────────────────────────────
path=(
  "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
  "$HOME/.sdkman/candidates/springboot/current/bin"
  $path
)
export PLAYDATE_SDK_PATH="$HOME/Developer/PlaydateSDK"

# Docker Desktop wrote this into ~/.zprofile on 07-09-2026 — which is this
# file, since the row is `link` mode. It arrived at the very top, above the
# header comment. Its marker comments are kept verbatim because they are what
# the installer greps for; deleted outright, the block returns at the top. The
# export is parameterised to $HOME, which the installer wrote literally — the
# practice deny.txt records, where the only literal CONFIG VALUE still in
# public/ is kitty.conf's, because kitty's config language cannot expand env
# vars and zsh plainly can. (bootstrap also holds the literal, but as the
# string it rewrites FROM — deny.txt draws that line and it is worth keeping:
# a grep here returns more hits than there are exceptions.)
# ⚠️ REDUNDANT, and kept anyway: every command ~/.docker/bin puts on PATH is
# also in /usr/local/bin, which is earlier — measured 07-09-2026, so `docker`
# resolves to /usr/local/bin/docker with or without this. That is also what
# makes the parameterisation cheap to be wrong about: if the installer matches
# the exact line rather than its comments it re-appends a literal duplicate,
# which `typeset -U path PATH` folds away and which changed nothing to begin
# with.
# ⭐ This line said "all five binaries" until an audit counted six — it dropped
# kubectl.docker. The claim only ever needed to be "everything here is also
# there", so it no longer carries a number: a count is a second fact to keep
# true, in a comment whose point was the resolution order.
# ⭐ The lesson is not about Docker. A `link` row means the repo file IS the
# live file, so any third-party installer that edits a well-known dotfile is a
# writer into this repo that nobody enrolled. Nothing here can prevent it;
# `git status` is what catches it.
# The following lines were added by Docker Desktop to add commands to your PATH.
export PATH="$PATH:$HOME/.docker/bin"
# End of Docker Desktop section.

# The Antigravity installer's line, kept as its marker so an update does
# not re-append it. Not redundant: under `typeset -U` a re-assignment keeps
# the FIRST occurrence, so this moves ~/.local/bin to the front, ahead of
# anything fronted earlier; a host overlay that cares re-fronts after it —
# .zprofile.local runs next.
export PATH="$HOME/.local/bin:$PATH"

# Machine-specific secrets and paths.
[ -f "$HOME/.zprofile.local" ] && source "$HOME/.zprofile.local"
