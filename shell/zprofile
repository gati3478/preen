# Per LOGIN shell — on this machine per kitty tab, which spawns each tab as
# a login shell. Nothing here may run for every `zsh -c`; the multiplier is
# tabs.

# ── Homebrew (single source of truth) ─────────────────────
# Apple silicon's prefix, then Intel's; a machine with neither skips it.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [ -x "$_brew" ]; then
    eval "$("$_brew" shellenv)"
    break
  fi
done
unset _brew
export HOMEBREW_NO_ANALYTICS=1   # no telemetry — local-only, like atuin
export HOMEBREW_BAT=1            # brew cat renders through bat

# ── Java ──────────────────────────────────────────────────
# `jset N` (in .zshrc) switches at runtime, and guards the same trap by hand:
# java_home's documented default is to fall back to the newest JDK when no
# filter matches, exit 0 — so without -F, removing temurin-21 would silently
# make every login shell's JAVA_HOME JDK 25. Guarded on the RESULT, not just
# the flag: -F prints nothing on a miss, and the assignment alone would then
# prepend a bare "/bin" to PATH.
if _jh="$(/usr/libexec/java_home -F -v 21 2>/dev/null)"; then
  export JAVA_HOME="$_jh"
  path=("$JAVA_HOME/bin" $path)
fi
unset _jh

# ── Installer-added paths ─────────────────────────────────
path=(
  "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
  "$HOME/.sdkman/candidates/springboot/current/bin"
  $path
)
export PLAYDATE_SDK_PATH="$HOME/Developer/PlaydateSDK"

# The Antigravity installer's line, kept as its marker so an update does
# not re-append it. Not redundant: under `typeset -U` a re-assignment keeps
# the FIRST occurrence, so this moves ~/.local/bin to the front, ahead of
# anything fronted earlier; a host overlay that cares re-fronts after it —
# .zprofile.local runs next.
export PATH="$HOME/.local/bin:$PATH"

# Machine-specific secrets and paths.
[ -f "$HOME/.zprofile.local" ] && source "$HOME/.zprofile.local"
