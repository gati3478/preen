[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[rebase]
	updateRefs = true
	autosquash = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[core]
	autocrlf = input
	# git runs a value with shell syntax through sh, so git log pages through
	# delta, else less, else cat, instead of dying.
	pager = "command -v delta >/dev/null 2>&1 && exec delta; command -v less >/dev/null 2>&1 && exec less; exec cat"
	untrackedCache = true
[init]
	defaultBranch = main
[interactive]
	# The same fallback: cat keeps add -p's hunks line for line, as git requires.
	diffFilter = "command -v delta >/dev/null 2>&1 && exec delta --color-only || exec cat"
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	# The ANSI ride (preferences.md § Colour): named 4-bit colors and pure
	# attributes only, so a kitty theme swap recolors diffs for free. delta's
	# `brightblack` keyword betrays the rule — it emits 38;5;8 — hence
	# `normal dim` for the zero style; preen doctor proves the output 4-bit.
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = reverse red
	plus-style = green
	plus-emph-style = reverse green
	line-numbers-minus-style = red
	line-numbers-plus-style = green
	line-numbers-zero-style = normal dim
[merge]
	conflictstyle = zdiff3
[include]
	path = ~/.gitconfig.local
