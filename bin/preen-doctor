#!/usr/bin/env bash
# Verify the deployed state against manifest.tsv, plus semantic checks.
#
# Enumerates every unit; never prints a tally. A count drifts between the
# checker and the checked and nobody notices — the vault has four separate
# instances of a doctor count going stale in under a week. Read the state
# off the run, not off a number.
#
#   preen doctor          every unit, one line each
#   preen doctor --quiet  the headings, every warn and FAIL, the verdict — an
#                         ok line prints nothing, and still nothing is counted
#   preen doctor --taste  also assert the preference spec where it is off by
#                         default: outside the source repo (see SOURCE_REPO)
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="$REPO/manifest.tsv"
FAILED=0
QUIET=no
TASTE=no
for arg in "$@"; do
  case "$arg" in
    --quiet) QUIET=yes ;;
    --taste) TASTE=yes ;;
    *) printf 'preen doctor: unknown argument: %s (--quiet, --taste)\n' "$arg" >&2; exit 2 ;;
  esac
done
source "$REPO/bin/lib/publish-fingerprint.sh"
[ -f "$REPO/bin/lib/pref-check.sh" ] && source "$REPO/bin/lib/pref-check.sh"

ok()   { [ "$QUIET" = yes ] || printf '  \033[32mok\033[0m    %s\n' "$1"; }
bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; FAILED=1; }
warn() { printf '  \033[33mwarn\033[0m  %s\n' "$1"; }

expand() { printf '%s' "${1/#\~/$HOME}"; }

# The public mirror ships bin/ and the configs, but never docs/, publish/,
# hosts/ or private/. Checks that assert a PREFERENCE of this machine's owner
# rather than whether something is broken are scoped to the source repo by
# it — an adopter never agreed to those decisions, and failing their correct
# setup over one is how a verification step loses its meaning.
SOURCE_REPO=no
# hosts/ never ships. docs/ was the test until 23-09-2026, and an adopter who
# added a docs/ directory to their clone had the author's taste asserted unasked.
[ -d "$REPO/hosts" ] && SOURCE_REPO=yes

# preen pull reconciles a copy row back into the repo and is NOT in the mirror.
# Naming it there sent an adopter after a tool they do not have, in the one
# message they are most likely to ever see: every copy row exists precisely
# because the application rewrites that file itself (found 14-09-2026).
if [ -x "$REPO/bin/preen-pull" ]; then
  RECONCILE="run preen pull to reconcile"
else
  RECONCILE="the application rewrote it — copy it over the repo's copy to keep the change, or re-run preen apply to discard it"
fi

echo "== manifest rows =="
rows_seen=0
while IFS=$'\t' read -r src tgt mode perms; do
  case "$src" in ''|'#'*) continue ;; esac
  rows_seen=$((rows_seen + 1))
  abs_tgt="$(expand "$tgt")"
  case "$mode" in
    link)
      if [ ! -L "$abs_tgt" ]; then
        bad "$tgt is not a symlink"
      elif [ ! -e "$abs_tgt" ]; then
        bad "$tgt is a DANGLING symlink -> $(readlink "$abs_tgt")"
      else
        # Compare the resolved link against $REPO/$src itself, not just its
        # containing directory — a directory-only compare lets any
        # transposition among same-directory rows (e.g. ~/.zshrc pointing
        # at public/shell/zshenv) pass as "ok".
        link_val="$(readlink "$abs_tgt")"
        link_dir="$(dirname "$link_val")"
        if [ -d "$link_dir" ]; then
          resolved="$(cd "$link_dir" && pwd)/$(basename "$link_val")"
        else
          resolved="$link_val"
        fi
        expected="$(cd "$REPO/$(dirname "$src")" && pwd)/$(basename "$src")"
        if [ "$resolved" != "$expected" ]; then
          bad "$tgt points to the wrong file -> $link_val (expected $REPO/$src)"
        else
          ok "$tgt"
        fi
      fi
      ;;
    copy)
      if [ ! -f "$abs_tgt" ]; then
        bad "$tgt missing"
      elif ! diff -q "$REPO/$src" "$abs_tgt" >/dev/null 2>&1; then
        bad "$tgt differs from repo — $RECONCILE"
      else
        ok "$tgt"
      fi
      ;;
    *)
      bad "$tgt has unknown mode '$mode' in manifest.tsv — row not checked"
      ;;
  esac

  # The `perms` column is APPLIED by preen apply (`chmod "$perms"`) and, until
  # 14-08-2026, was verified by nothing here — this loop read $perms and never
  # used it. So a host's ssh config could drift from 0600 to 0644 and every row
  # still reported ok: the column looked like a guarantee and was only ever an
  # instruction. -L on purpose, because chmod follows symlinks, so the mode that
  # matters for a link row is the resolved file's.
  if [ -n "${perms:-}" ] && [ -e "$abs_tgt" ]; then
    actual="$(stat -Lf '%OLp' "$abs_tgt" 2>/dev/null || stat -Lc '%a' "$abs_tgt" 2>/dev/null)"
    if [ -z "$actual" ]; then
      warn "$tgt: could not read mode to compare against manifest's $perms"
    elif [ "$actual" != "${perms#0}" ] && [ "$actual" != "$perms" ]; then
      bad "$tgt has mode $actual, manifest declares $perms"
    else
      ok "$tgt mode $perms"
    fi
  fi
done < "$MANIFEST"

# A row can be silently dropped without ever reaching the case above — e.g.
# a space-separated row (no tab) reads entirely into $src, which then
# doesn't match the ''|'#'* skip either, so it falls through into a mode
# check with $mode empty; or the manifest loses its trailing newline and
# `read` drops the last line outright (the classic `while read` gotcha).
# preen apply hard-errors on a bad row; this makes preen doctor unable to
# silently see fewer rows than the manifest actually has.
expected_rows=$(awk -F'\t' '$1 !~ /^($|#)/ { c++ } END { print c+0 }' "$MANIFEST")
if [ "$rows_seen" -ne "$expected_rows" ]; then
  bad "processed $rows_seen manifest row(s) but the file has $expected_rows — a row was silently skipped"
fi

echo "== semantic checks =="

# kitty resolves `include` relative to the config file's own directory.
if [ -f "$HOME/.config/kitty/current-theme.conf" ]; then
  ok "kitty theme sits beside kitty.conf (relative include resolves)"
else
  bad "current-theme.conf missing beside kitty.conf — colours silently revert to defaults"
fi

# atuin is local-only by decision: no account, no sync. Logging in is what
# creates this file, so its absence IS the enforcement — config keys cannot
# express "never logged in". A decision, not a defect, so it is not asserted
# against an adopter who may well want atuin sync.
if [ "$SOURCE_REPO" = no ]; then
  :
elif [ ! -f "$HOME/.local/share/atuin/session" ]; then
  ok "atuin is local-only (no session file — never logged in)"
else
  bad "atuin has a session file — an account is logged in, against the local-only decision"
fi

# eza rides the terminal's 16 ANSI colours BY DEFAULT (measured 27-08-2026:
# only 4-bit SGR codes in its output) — a state no text reader can see, and
# one a version bump could change silently. Proven behaviourally: a fixture
# run must emit no 256-colour or truecolor codes. A 4-bit remap via
# EZA_COLORS/LS_COLORS would pass, and should: it still rides the palette.
# theme.yml is checked by absence because it is palette-carrying by
# construction. Control: the fixture guarantees coloured output exists (a
# dir and an executable), so an empty capture fails rather than passing.
if command -v eza >/dev/null 2>&1; then
  eza_fixture="$(mktemp -d)"
  mkdir "$eza_fixture/dir" && touch "$eza_fixture/exec" && chmod +x "$eza_fixture/exec"
  eza_out="$(eza --color=always -la "$eza_fixture" 2>/dev/null)"
  rm -rf "$eza_fixture"
  if ! printf '%s' "$eza_out" | grep -q $'\x1b\['; then
    bad "eza emitted no colour at all — the ANSI-rider check has nothing to prove"
  elif printf '%s' "$eza_out" | grep -qE $'\x1b\[[0-9;]*(38|48);(5|2);'; then
    bad "eza emitted 256-colour/truecolor SGR codes — no longer riding the 16 ANSI colours (version bump? EZA_COLORS/LS_COLORS set?)"
  elif [ "$SOURCE_REPO" = yes ] && [ -f "$HOME/.config/eza/theme.yml" ]; then
    bad "~/.config/eza/theme.yml exists — a palette-carrying override against the rider rule"
  else
    ok "eza rides the 16 ANSI colours (4-bit output, no theme.yml)"
  fi
else
  warn "eza not installed — skipping the ANSI-rider check"
fi

# delta rides the 16 ANSI colours BY CONFIGURATION (the deployed gitconfig's
# [delta] block — syntax-theme ansi plus named-ANSI styles), unlike eza's
# by-default ride above, and an upgrade can grow a new decorated element
# whose default is truecolor without any asserted key changing. Proven the
# same way: a fixture diff must colour without 256-colour or truecolor SGR.
# 38;5;0-15 would still resolve to the terminal palette, but the one case
# delta was measured to emit came from a keyword colour the config
# deliberately avoids (brightblack -> 38;5;8), so the strict grep doubles
# as a guard against reintroducing one. Control: the fixture guarantees
# changed lines exist.
if command -v delta >/dev/null 2>&1 && command -v git >/dev/null 2>&1; then
  delta_fixture="$(mktemp -d)"
  printf 'line one\nline two\n' > "$delta_fixture/a"
  printf 'line one\nline TWO\n' > "$delta_fixture/b"
  delta_out="$(git diff --no-index "$delta_fixture/a" "$delta_fixture/b" 2>/dev/null | delta --width 100 2>/dev/null)"
  rm -rf "$delta_fixture"
  if ! printf '%s' "$delta_out" | grep -q $'\x1b\['; then
    bad "delta emitted no colour at all — the ANSI-rider check has nothing to prove"
  elif printf '%s' "$delta_out" | grep -qE $'\x1b\[[0-9;]*(38|48);(5|2);'; then
    bad "delta emitted 256-colour/truecolor SGR codes — not riding the 16 ANSI colours (deployed [delta] styles changed, or an upgrade grew a truecolor default)"
  else
    ok "delta rides the 16 ANSI colours (4-bit output on a fixture diff)"
  fi
else
  warn "delta or git not installed — skipping the delta ANSI-rider check"
fi

# rg rides the terminal's 16 ANSI colours BY DEFAULT, the eza shape
# (measured 29-08-2026: path magenta 35, line green 32, match bold+red
# as separate 1m and 31m — nothing but 4-bit in a fixture run). Nothing asserts a colour
# key, so only behaviour can notice an upgrade growing a 256-colour
# default or a --colors line creeping into the managed config. The
# managed config is deliberately part of the run (RIPGREP_CONFIG_PATH),
# so a palette-carrying line there fails here too.
if command -v rg >/dev/null 2>&1; then
  rg_fixture="$(mktemp -d)"
  printf 'needle here\n' > "$rg_fixture/f.txt"
  rg_out="$(RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config" rg --color=always -n needle "$rg_fixture" 2>/dev/null)"
  rm -rf "$rg_fixture"
  if ! printf '%s' "$rg_out" | grep -q $'\x1b\['; then
    bad "rg emitted no colour at all — the ANSI-rider check has nothing to prove"
  elif printf '%s' "$rg_out" | grep -qE $'\x1b\[[0-9;]*(38|48);(5|2);'; then
    bad "rg emitted 256-colour/truecolor SGR codes — no longer riding the 16 ANSI colours (version bump? a --colors line in the managed config?)"
  else
    ok "rg rides the 16 ANSI colours (4-bit output on a fixture match)"
  fi
else
  warn "rg not installed — skipping the rg ANSI-rider check"
fi

# The global excludes file is a manifest row; this proves git actually
# CONSULTS it. core.excludesFile unset falls back to the XDG path the row
# deploys, so an override appearing in any scope would silently detach the
# deployed file while every text read stayed green. Negative control: a
# name the file does not list must NOT be ignored, or the probe proved
# nothing about the two that were.
if command -v git >/dev/null 2>&1; then
  ign_fixture="$(mktemp -d)"
  git -C "$ign_fixture" init -q 2>/dev/null
  mkdir -p "$ign_fixture/.claude"
  touch "$ign_fixture/.DS_Store" "$ign_fixture/.claude/settings.local.json" "$ign_fixture/control.txt"
  if ! git -C "$ign_fixture" check-ignore -q .DS_Store; then
    bad "global excludes: .DS_Store is NOT ignored — git is not consulting the deployed ignore file"
  elif ! git -C "$ign_fixture" check-ignore -q .claude/settings.local.json; then
    bad "global excludes: .claude/settings.local.json is NOT ignored — the **/ pattern no longer matches"
  elif git -C "$ign_fixture" check-ignore -q control.txt; then
    bad "global excludes: the negative control IS ignored — the probe proves nothing"
  else
    ok "global excludes live (.DS_Store and .claude/settings.local.json ignored; control isn't)"
  fi
  rm -rf "$ign_fixture"
fi

# core.fsmonitor is WITHDRAWN (preferences.md § Git, 15-09-2026): a prompt
# runs git with GIT_OPTIONAL_LOCKS=0 and git will not start the daemon under
# it, so every render pays a 1.088s handshake and falls back to the walk —
# forever, since the prompt is the one caller that cannot start what it needs.
# The gitcfg row reads the FILE for the key coming back; this reads git's own
# EFFECTIVE boolean, so `1`, `yes` and `on` are caught too, and so is a value
# arriving from a scope the manifest does not own.
#
# Until 15-09-2026 this block asserted the opposite, and its own `git status`
# STARTED the daemon it then checked for — so a doctor run repaired the
# symptom it was meant to report, in this repo only.
#
# Source-repo only: it asserts a decision of Gati's, not a broken setup, and
# an adopter with a 100k-file monorepo and a daemon already running has made a
# different call correctly. Also scoped to a work tree — a ZIP download of the
# mirror has no .git, so `config --get` fell through to the GLOBAL scope and a
# correct setup was told its daemon was missing (14-09-2026, found once the
# $USER abort above stopped hiding this line).
if [ "$SOURCE_REPO" = yes ] && git -C "$REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  if [ "$(git -C "$REPO" config --type=bool --get core.fsmonitor 2>/dev/null)" = "true" ]; then
    bad "core.fsmonitor is true in effect — withdrawn; it costs the prompt 1.088s per repo per boot (preferences.md § Git)"
  else
    ok "core.fsmonitor is not in effect (withdrawn — a prompt cannot start its daemon)"
  fi
fi

# The check below needs a real file at $REPO/<src>. In the checked-out repo
# that's public/shell/zshrc, but this same script is also staged verbatim
# into the flattened public mirror (see bin/preen-publish), where there is no
# public/ prefix at all — the row's source there is just shell/zshrc.
# Deriving the path from manifest.tsv (present, correctly stripped, in both
# layouts) instead of hardcoding "public/..." is what makes one script
# correct in both. (A cship `width` vs `tput cols` comparison lived here until
# 02-09-2026; cship never reads `width` in a terminal — see docs/traps.md.)
manifest_src_for_target() {
  awk -F'\t' -v t="$1" '$2 == t { print $1; exit }' "$MANIFEST"
}

# z-sy-h must be the last thing that creates or wraps ZLE widgets. `zle -N`
# (and `zle -C`) create widgets directly, without going through `source` or
# `eval` — a `zle -N` line appended below z-sy-h is exactly the D1-class
# regression this check exists for, so it has to be matched too, not just
# the two ways of pulling in someone else's plugin.
zshrc_src="$(manifest_src_for_target '~/.zshrc')"
if [ -n "$zshrc_src" ] && [ -f "$REPO/$zshrc_src" ]; then
  last_source=$(grep -nE 'source|eval|zle +-[NC]' "$REPO/$zshrc_src" | tail -1)
  if printf '%s' "$last_source" | grep -q 'zsh-syntax-highlighting'; then
    ok "zsh-syntax-highlighting is sourced last"
  else
    bad "something is sourced after zsh-syntax-highlighting: $last_source"
  fi
else
  warn "zshrc not found via manifest (~/.zshrc) — skipping z-sy-h ordering check"
fi

# This machine's decision: the directory was deleted rather than wired in.
# Source-repo only, and for two reasons — the shipped zshrc adds only
# ~/.docker/completions to fpath, so an adopter who HAS this directory could
# never pass, and the passing branch printed a bare "D4" that appears nowhere
# else in the mirror (both found 14-09-2026). It also spends a second
# launching an interactive login zsh.
if [ "$SOURCE_REPO" = yes ]; then
  if [ -d "$HOME/.zsh/completions" ]; then
    if script -q /dev/null zsh -l -i -c 'print -l $fpath' 2>/dev/null | tr -d '\r' | grep -q '.zsh/completions'; then
      ok "~/.zsh/completions is in fpath"
    else
      bad "~/.zsh/completions exists but is not in fpath"
    fi
  else
    ok "~/.zsh/completions absent (deleted rather than wired in)"
  fi
fi

# Three states, not two. An unsuffixed dump is the defect; NO dump is a
# machine where zsh has not started under this config yet — the state a
# fresh clone is in the moment bootstrap finishes, and the run the mirror's
# README invites next. Failing there told an adopter their correct install
# was broken (found 14-09-2026 from a fresh clone; one zsh makes it green).
if ls "$HOME"/.zcompdump-* >/dev/null 2>&1; then
  ok "zcompdump is version-suffixed"
elif [ -e "$HOME/.zcompdump" ]; then
  bad "~/.zcompdump is not version-suffixed — a zsh upgrade can serve a stale dump"
else
  warn "no zcompdump yet — open a zsh once, then re-run (compinit writes ~/.zcompdump-\$ZSH_VERSION)"
fi

# kitty starts every tab through /usr/bin/login (`login -f -l -p $USER …`,
# read off the process table), and login prints "Last login: …" until
# ~/.hushlogin exists — a manifest row since 02-09-2026. The row proves the
# file is deployed; this proves the mechanism the file exists for is the one
# in play, so the pair says "a new tab opens at the prompt". The effect was
# proven once, both ways, with kitty's exact invocation under a PTY; it is
# NOT re-run here because every `login -f` leaves a utmpx record (`last`
# showed one per probe that day). Silent when kitty is not running — the
# mirror's CI, or a Mac with no tab open.
# $USER is unset under `env -i` (a sandboxed test, cron, a container), and
# `set -u` turned that into an abort that skipped every check below — found
# 14-09-2026 running this script from a fresh clone of the mirror. No $USER,
# no kitty tab to ask about: silent, like kitty not running.
if [ -n "${USER:-}" ] && pgrep -qf "/usr/bin/login -f -l -p $USER " 2>/dev/null; then
  if [ -f "$HOME/.hushlogin" ]; then
    ok "kitty tabs start through login, and ~/.hushlogin keeps the banner off"
  else
    bad "kitty tabs start through login and ~/.hushlogin is missing — every new tab opens under a 'Last login' banner"
  fi
fi

# The public mirror must not silently fall behind. Honours $PREEN_MIRROR, the
# same override preen publish accepts — a doctor that checks a different
# path than the tool that maintains it is its own drift.
# The next two checks are SOURCE-REPO ONLY.
# preen publish stages this script verbatim into the public mirror, where
# `publish/` does not exist and neither does bin/preen-publish itself. Run there,
# the currency check could never pass (its fingerprint hashes HEAD:public and
# HEAD:docs/public-README.md, neither of which survives the flattening) and its
# advice pointed at a script that was never shipped. An adopter got a permanent
# false warning from a tool published so the repo could receive contributions.
# `publish/` is the context signal — same guard style as blocked-upstream.md
# below. Found by audit 09-08-2026.
if [ -d "$REPO/publish" ]; then
  MIRROR="${PREEN_MIRROR:-$HOME/Development/preen}"
  if [ -d "$MIRROR/.git" ]; then
    here=$(publish_fingerprint "$REPO" 2>/dev/null || echo none)
    marker=$(cat "$REPO/publish/.last-published" 2>/dev/null || echo none)
    if [ "$here" = "$marker" ]; then
      ok "public mirror is current"
    else
      warn "public/ has changed since the last publish — run preen publish"
    fi
  else
    warn "public mirror not cloned at $MIRROR"
  fi

  # The expected account is DERIVED from origin, not hardcoded. It read
  # `grep -q 'gati3478'` until 09-08-2026, so every other user of the mirror was
  # told their correct account was the wrong one — the same class of defect as
  # the four-of-five hardcoded /Users/gati3478 paths parameterised in Task 20
  # (deny.txt has the count; this line said "the five" until 07-09-2026, which
  # disagreed with it — the fifth is kitty.conf's, and stays literal).
  origin_url=$(git -C "$REPO" remote get-url origin 2>/dev/null || echo '')
  expected_owner=$(printf '%s' "$origin_url" | sed -E 's#.*[:/]([^/]+)/[^/]+$#\1#')
  if [ -z "$expected_owner" ] || [ "$expected_owner" = "$origin_url" ]; then
    warn "could not derive the expected gh account from origin ('${origin_url:-unset}') — check manually"
  elif gh auth status 2>&1 | grep -B1 'Active account: true' | grep -q "$expected_owner"; then
    ok "gh active account is $expected_owner"
  else
    warn "gh active account is NOT $expected_owner — repo operations would hit the wrong account"
  fi
fi

# A deferral must not become permanent by neglect.
if [ -f "$REPO/docs/blocked-upstream.md" ]; then
  installed=$("$HOME/.local/bin/cship" --version 2>/dev/null | awk '{print $NF}')
  broken=$(awk -F'`' '/cship.*broken at/{print $2; exit}' "$REPO/docs/blocked-upstream.md")
  # An unparseable state (cship missing/erroring, or the awk pattern no
  # longer matching blocked-upstream.md's prose) previously fell through
  # to the same "ok" as a genuinely-confirmed-unchanged version, silently
  # asserting something that was never actually checked.
  if [ -z "$installed" ] || [ -z "$broken" ]; then
    warn "could not determine cship version or blocked-upstream entry (installed='${installed:-?}' recorded='${broken:-?}') — re-check manually"
  elif [ "$installed" != "$broken" ]; then
    warn "cship is $installed, recorded broken at $broken — re-check cship#194"
  else
    ok "blocked-upstream entries unchanged"
  fi
fi

# The pre-commit hook (glyph integrity, TOML parse) is opt-in PER CLONE via
# `git config core.hooksPath .githooks`. Nothing enforced it, and nothing
# noticed when it was absent — so on a fresh clone the only commit-time
# protection was silently off until someone remembered the README line. This
# turns "silently unprotected" into a visible warning.
# Source-repo only, for the same reason as the two checks above: the mirror
# ships no .githooks, so this warned falsely there. I introduced that false
# warning earlier the same day while fixing a different one — which is exactly
# why the guard belongs on the check itself, not on a promise to remember.
if [ -d "$REPO/.githooks" ]; then
  hooks_path="$(git -C "$REPO" config --get core.hooksPath 2>/dev/null || true)"
  if [ "$hooks_path" = ".githooks" ]; then
    ok "pre-commit hooks enabled (core.hooksPath=.githooks)"
  else
    warn "pre-commit hooks NOT enabled — run: git -C \"$REPO\" config core.hooksPath .githooks (found '${hooks_path:-unset}')"
  fi
fi

# Machine-specific checks that cannot be published. Each module prints its own
# heading and calls ok/bad/warn from this scope; nothing here registers or
# enumerates them, so adding one is adding a file. The extension point is
# generic on purpose: a check written inline would ship in the mirror and
# describe infrastructure that no deny.txt entry could catch, because none of
# it is a secret string — it is the shape of a private setup. The mirror
# carries no hosts/, so this loop finds nothing there and names nothing.
# Each module prints its own heading for the same reason run_pref_checks does:
# a heading printed here would leave a bare section with nothing under it.
for _mod in "$REPO"/hosts/*/doctor.d/*.sh; do
  [ -f "$_mod" ] && source "$_mod"
done
unset _mod

# Asserts the preference spec against LIVE config — what the applications
# actually render, not what this repo believes they were given. The manifest
# checks above prove deployment; these prove the deployed values are the ones
# preferences.md claims. Two different questions: a copy-mode file can match the
# repo perfectly and still carry a value the SSOT never sanctioned.
# The header is printed by run_pref_checks itself, after its own guard. Printing
# it here would leave a bare heading with nothing under it in the public mirror,
# which ships bin/ but not docs/ — a section that looks broken rather than absent.
# Outside the source repo the spec is the author's taste, asserted only when
# asked for (--taste): an adopter's correct setup is not failed over it.
if declare -f run_pref_checks >/dev/null 2>&1 && { [ "$SOURCE_REPO" = yes ] || [ "$TASTE" = yes ]; }; then
  run_pref_checks "$REPO" || FAILED=1
fi

echo "--"
[ "$FAILED" -eq 0 ] && echo "no failures" || echo "FAILURES ABOVE"
exit "$FAILED"
