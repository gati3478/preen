#!/usr/bin/env bash
# Verify the deployed state against manifest.tsv, plus semantic checks.
#
# Enumerates every unit; never prints a tally. A count drifts between the
# checker and the checked and nobody notices. Read the state off the run, not
# off a number.
#
#   preen doctor          every unit, one line each
#   preen doctor --quiet  the headings, every warn and FAIL, the verdict — an
#                         ok line prints nothing, and still nothing is counted
#   preen doctor --taste  also assert the preference spec where it is off by
#                         default: outside the source repo (see SOURCE_REPO)
set -uo pipefail

usage() { cat <<'EOF'
usage: preen doctor [--quiet] [--taste]

Verifies the deployed state against manifest.tsv, then the semantic checks:
every unit, one line each, and never a tally. Exit 0 with no FAIL, 1 with one.

  --quiet     the headings, every warn and FAIL, the verdict; an ok line
              prints nothing, and still nothing is counted
  --taste     also assert the preference spec outside the source repo, where
              it is off by default
  -h, --help  print this and exit
EOF
}
for arg in "$@"; do
  case "$arg" in -h|--help) usage; exit 0 ;; esac
done
QUIET=no
TASTE=no
for arg in "$@"; do
  case "$arg" in
    --quiet) QUIET=yes ;;
    --taste) TASTE=yes ;;
    *) echo "preen doctor: unknown argument: $arg (see --help)" >&2; exit 2 ;;
  esac
done

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="$REPO/manifest.tsv"
FAILED=0
[ -f "$REPO/bin/lib/pref-check.sh" ] && source "$REPO/bin/lib/pref-check.sh"

ok()   { [ "$QUIET" = yes ] || printf '  \033[32mok\033[0m    %s\n' "$1"; }
bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; FAILED=1; }
warn() { printf '  \033[33mwarn\033[0m  %s\n' "$1"; }

# A Mac without the Command Line Tools still has /usr/bin/git and
# /usr/bin/python3: stubs that raise an install dialog when run. So the tool
# behind the stub is looked for, never run; `xcode-select -p` alone is not
# enough, it prints a stale selection and exits 0.
bare_shim() { # bare_shim <tool> → true when <tool> is macOS's /usr/bin stub with no developer tools behind it
  local dir
  [ "$(command -v "$1" 2>/dev/null)" = "/usr/bin/$1" ] && [ -x /usr/bin/xcode-select ] || return 1
  dir="$(/usr/bin/xcode-select -p 2>/dev/null)" && [ -x "$dir/usr/bin/$1" ] && return 1
  return 0
}

# For printing, HOME as ~. `${1/#$HOME/\~}` keeps the backslash in bash, the
# trap preen apply's own short() names. A HOME of /h/ names /h: under it, /h/x
# and the /h//x that "$HOME/x" builds both print ~/x.
short() { # short <path> → the path with $HOME written as ~
  local home="$HOME" rest
  while [ "${home%/}" != "$home" ]; do home="${home%/}"; done
  # Stripped to nothing, a HOME of / would hold every path; it is matched as given.
  [ -n "$home" ] || home="$HOME"
  case "$1" in
    "$home"|"$home"/*) rest="${1#"$home"}" ;;
    *) printf '%s' "$1"; return 0 ;;
  esac
  while [ "${rest#//}" != "$rest" ]; do rest="${rest#/}"; done
  [ "$rest" != / ] || rest=""
  printf '~%s' "$rest"
}

# Checks that assert a PREFERENCE of this repo's owner, or read files only the
# source repo has, run only there: an adopter never agreed to those decisions,
# and failing their correct setup over one is how a verification step loses
# its meaning. Inside the source repo, such a file missing is a warn.
SOURCE_REPO=no
# The one test: the list of what ships, which never ships itself. A directory
# is no test — an adopter's clone may grow a hosts/, a publish/ or a .githooks/
# of its own, and this repo's taste would then be asserted on it.
[ -f "$REPO/bin/lib/stage-mirror.sh" ] && SOURCE_REPO=yes

# preen pull, which reconciles a copy row back into the repo, is named only
# where it exists; a copy of this repo without it gets the manual remedy.
if [ -x "$REPO/bin/preen-pull" ]; then
  RECONCILE="run preen pull to reconcile"
else
  RECONCILE="the application rewrote it — copy it over the repo's copy to keep the change, or re-run preen apply to discard it"
fi

echo "== manifest rows =="
rows_seen=0
while IFS=$'\t' read -r src tgt mode perms; do
  case "$src" in ''|'#'*) continue ;; esac
  rows_seen=$((rows_seen + 1))
  # Not `${tgt/#\~/$HOME}`: bash 5.2 reads an `&` in HOME as the matched `~`.
  case "$tgt" in '~'|'~/'*) abs_tgt="$HOME${tgt#\~}" ;; *) abs_tgt="$tgt" ;; esac
  case "$mode" in
    link)
      if [ ! -L "$abs_tgt" ]; then
        bad "$tgt is not a symlink"
      elif [ ! -e "$abs_tgt" ]; then
        bad "$tgt is a DANGLING symlink -> $(readlink "$abs_tgt")"
      else
        # Compare the resolved link against $REPO/$src itself, not just its
        # containing directory — a directory-only compare lets any
        # transposition among same-directory rows (e.g. ~/.zshrc pointing
        # at public/shell/zshenv) pass as "ok".
        link_val="$(readlink "$abs_tgt")"
        link_dir="$(dirname "$link_val")"
        if [ -d "$link_dir" ]; then
          resolved="$(cd "$link_dir" && pwd)/$(basename "$link_val")"
        else
          resolved="$link_val"
        fi
        expected="$(cd "$REPO/$(dirname "$src")" && pwd)/$(basename "$src")"
        if [ "$resolved" != "$expected" ]; then
          bad "$tgt points to the wrong file -> $link_val (expected $REPO/$src)"
        else
          ok "$tgt"
        fi
      fi
      ;;
    copy)
      if [ ! -f "$abs_tgt" ]; then
        bad "$tgt missing"
      elif ! diff -q "$REPO/$src" "$abs_tgt" >/dev/null 2>&1; then
        bad "$tgt differs from repo — $RECONCILE"
      else
        ok "$tgt"
      fi
      ;;
    *)
      bad "$tgt has unknown mode '$mode' in manifest.tsv — row not checked"
      ;;
  esac

  # preen apply applies the `perms` column (`chmod "$perms"`); this verifies it,
  # so a mode that drifts, an ssh config from 0600 to 0644, fails instead of
  # reading ok. -L on purpose, because chmod follows symlinks, so the mode that
  # matters for a link row is the resolved file's.
  # GNU's form first: BSD stat rejects -c and prints nothing, while GNU stat
  # reads -f as "file system" and prints a dump of it before failing.
  if [ -n "${perms:-}" ] && [ -e "$abs_tgt" ]; then
    actual="$(stat -Lc '%a' "$abs_tgt" 2>/dev/null || stat -Lf '%OLp' "$abs_tgt" 2>/dev/null)"
    if [ -z "$actual" ]; then
      warn "$tgt: could not read mode to compare against manifest's $perms"
    elif [ "$actual" != "${perms#0}" ] && [ "$actual" != "$perms" ]; then
      bad "$tgt has mode $actual, manifest declares $perms"
    else
      ok "$tgt mode $perms"
    fi
  fi
done < "$MANIFEST"

# A row can be silently dropped without ever reaching the case above — e.g.
# a space-separated row (no tab) reads entirely into $src, which then
# doesn't match the ''|'#'* skip either, so it falls through into a mode
# check with $mode empty; or the manifest loses its trailing newline and
# `read` drops the last line outright (the classic `while read` gotcha).
# preen apply hard-errors on a bad row; this makes preen doctor unable to
# silently see fewer rows than the manifest actually has.
expected_rows=$(awk -F'\t' '$1 !~ /^($|#)/ { c++ } END { print c+0 }' "$MANIFEST")
if [ "$rows_seen" -ne "$expected_rows" ]; then
  bad "a row of manifest.tsv was silently skipped (missing trailing newline?)"
fi

# preen apply, bootstrap and the drop-ins move an adopter's file aside as
# <file>.unpreened.<stamp>[.N] — earlier versions of the first two as
# <file>.unpreened[.N], which a machine may still hold — and say so once, so a
# copy row an application keeps rewriting piles them up unseen. Every
# directory a row deploys into is searched rather than each row's own name, so
# a backup outlives the row that made it; the prompt drop-in's ~/.claude, the
# kitty drop-in's ~/.config/kitty/preen, the shell drop-in's
# ~/.config/zsh/preen, the tmux drop-in's ~/.config/tmux/preen and the git
# drop-in's ~/.config/git/preen, which no row names, are added here. A
# function, not inline: bash 3.2 reads a `case` pattern's `)` inside $( ) as
# the end of the substitution.
backups_beside_rows() {
  local src tgt abs dir
  {
    while IFS=$'\t' read -r src tgt _; do
      case "$src" in ''|'#'*) continue ;; esac
      case "$tgt" in '~'|'~/'*) abs="$HOME${tgt#\~}" ;; *) abs="$tgt" ;; esac
      printf '%s\n' "${abs%/*}"
    done < "$MANIFEST"
    printf '%s\n' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" "$HOME/.config/kitty/preen" "$HOME/.config/zsh/preen" "$HOME/.config/tmux/preen" "$HOME/.config/git/preen"
  } | sort -u | while IFS= read -r dir; do
    # -H: find does not descend a starting point that is a symlink, and HOME
    # or ~/.claude may be one.
    if [ -d "$dir" ]; then
      find -H "$dir" -maxdepth 1 -name '*.unpreened*' 2>/dev/null
    fi
  done | LC_ALL=C sort
}

echo "== backups =="
# Byte order keeps each original's backups adjacent: they share its name as a
# prefix. Stamped names sort by time; a bare or numbered one, written by an
# earlier preen apply or bootstrap, carries no time, so where it lands says
# nothing of its age. One warn per original, its backups listed, never counted.
backups="$(backups_beside_rows)"
if [ -z "$backups" ]; then
  ok "nothing moved aside beside a deployed file"
else
  orig="" names=""
  while IFS= read -r b; do
    if [ -n "$orig" ] && [ "${b%%.unpreened*}" != "$orig" ]; then
      warn "$(short "$orig") — moved aside as:$names; diff, keep what you need, delete"
      names=""
    fi
    orig="${b%%.unpreened*}"
    names="$names ${b##*/}"
  done <<< "$backups"
  warn "$(short "$orig") — moved aside as:$names; diff, keep what you need, delete"
fi

echo "== semantic checks =="

# kitty resolves `include` relative to the config file's own directory.
if [ -f "$HOME/.config/kitty/current-theme.conf" ]; then
  ok "kitty theme sits beside kitty.conf (relative include resolves)"
else
  bad "current-theme.conf missing beside kitty.conf — colours silently revert to defaults"
fi

# atuin is local-only by decision: no account, no sync. Logging in is what
# creates this file, so its absence IS the enforcement — config keys cannot
# express "never logged in". A decision, not a defect, so it is not asserted
# against an adopter who may well want atuin sync.
if [ "$SOURCE_REPO" = no ]; then
  :
elif [ ! -f "$HOME/.local/share/atuin/session" ]; then
  ok "atuin is local-only (no session file — never logged in)"
else
  bad "atuin has a session file — an account is logged in, against the local-only decision"
fi

# The fixtures below are made under one directory, each removed as its check
# ends, and the directory on exit, however the run ends. This script sets no
# other trap. Named, and in TMPDIR, which macOS's `mktemp -d` alone ignores.
# Where TMPDIR cannot hold it, each check that needs a fixture warns and
# skips: an empty path would run the excludes probe's `git init` in the
# caller's directory.
FIXTURES="$(mktemp -d "${TMPDIR:-/tmp}/preen-doctor.XXXXXX" 2>/dev/null)" || FIXTURES=""
trap '[ -z "$FIXTURES" ] || rm -rf "$FIXTURES"' EXIT
fixture() { # fixture <name> → a new directory under FIXTURES; fails when there is none
  [ -n "$FIXTURES" ] && mktemp -d "$FIXTURES/$1.XXXXXX" 2>/dev/null
}
NO_FIXTURE="could not make a scratch directory in ${TMPDIR:-/tmp}"

# eza rides the terminal's 16 ANSI colours BY DEFAULT (measured 27-08-2026:
# only 4-bit SGR codes in its output) — a state no text reader can see, and
# one a version bump could change silently. Proven behaviourally: a fixture
# run must emit no 256-colour or truecolor codes. A 4-bit remap via
# EZA_COLORS/LS_COLORS would pass, and should: it still rides the palette.
# theme.yml is checked by absence because it is palette-carrying by
# construction. Control: the fixture guarantees coloured output exists (a
# dir and an executable), so an empty capture fails rather than passing.
if ! command -v eza >/dev/null 2>&1; then
  warn "eza not installed — skipping the ANSI-rider check"
elif ! eza_fixture="$(fixture eza)"; then
  warn "$NO_FIXTURE — skipping the eza ANSI-rider check"
else
  mkdir "$eza_fixture/dir" && touch "$eza_fixture/exec" && chmod +x "$eza_fixture/exec"
  eza_out="$(eza --color=always -la "$eza_fixture" 2>/dev/null)"
  rm -rf "$eza_fixture"
  if ! grep -q $'\x1b\[' <<< "$eza_out"; then
    bad "eza emitted no colour at all — the ANSI-rider check has nothing to prove"
  elif grep -qE $'\x1b\[[0-9;]*(38|48);(5|2);' <<< "$eza_out"; then
    bad "eza emitted 256-colour/truecolor SGR codes — no longer riding the 16 ANSI colours (version bump? EZA_COLORS/LS_COLORS set?)"
  elif [ "$SOURCE_REPO" = yes ] && [ -f "$HOME/.config/eza/theme.yml" ]; then
    bad "~/.config/eza/theme.yml exists — a palette-carrying override against the rider rule"
  else
    ok "eza rides the 16 ANSI colours (4-bit output, no theme.yml)"
  fi
fi

# delta rides the 16 ANSI colours BY CONFIGURATION (the deployed gitconfig's
# [delta] block — syntax-theme ansi plus named-ANSI styles), unlike eza's
# by-default ride above, and an upgrade can grow a new decorated element
# whose default is truecolor without any asserted key changing. Proven the
# same way: a fixture diff must colour without 256-colour or truecolor SGR.
# 38;5;0-15 would still resolve to the terminal palette, but the one case
# delta was measured to emit came from a keyword colour the config
# deliberately avoids (brightblack -> 38;5;8), so the strict grep doubles
# as a guard against reintroducing one. Control: the fixture guarantees
# changed lines exist. Blame is its own fixture: delta's default blame
# palette is hex, a ride the diff never shows. Two commits in git blame's
# own format, which delta reads with no repository behind it, so the
# palette's black stripe guarantees colour there.
if ! command -v git >/dev/null 2>&1; then
  warn "git not installed — skipping the delta ANSI-rider check"
elif bare_shim git; then
  warn "git needs the Command Line Tools here (xcode-select --install) — skipping the delta ANSI-rider check"
elif ! command -v delta >/dev/null 2>&1; then
  # The shipped gitconfig falls back to less when delta is absent, so git works.
  warn "delta not installed — git pages through less; skipping the delta ANSI-rider check"
elif ! delta_fixture="$(fixture delta)"; then
  warn "$NO_FIXTURE — skipping the delta ANSI-rider check"
else
  printf 'line one\nline two\n' > "$delta_fixture/a"
  printf 'line one\nline TWO\n' > "$delta_fixture/b"
  delta_diff="$(git diff --no-index "$delta_fixture/a" "$delta_fixture/b" 2>/dev/null | delta --width 100 2>/dev/null)"
  rm -rf "$delta_fixture"
  delta_blame="$(printf '%s\n' 'aaaaaaaa (A U Thor 2026-01-01 00:00:00 +0000 1) line one' \
    'bbbbbbbb (A U Thor 2026-01-02 00:00:00 +0000 2) line two' | delta --width 100 2>/dev/null)"
  for fx in diff blame; do
    if [ "$fx" = diff ]; then delta_out="$delta_diff"; else delta_out="$delta_blame"; fi
    if ! grep -q $'\x1b\[' <<< "$delta_out"; then
      bad "delta emitted no colour at all on a fixture $fx — the ANSI-rider check has nothing to prove there"
    elif grep -qE $'\x1b\[[0-9;]*(38|48);(5|2);' <<< "$delta_out"; then
      bad "delta emitted 256-colour/truecolor SGR codes on a fixture $fx — not riding the 16 ANSI colours (deployed [delta] styles changed, or an upgrade grew a truecolor default)"
    else
      ok "delta rides the 16 ANSI colours (4-bit output on a fixture $fx)"
    fi
  done
fi

# rg rides the terminal's 16 ANSI colours BY DEFAULT, the eza shape
# (measured 29-08-2026: path magenta 35, line green 32, match bold+red
# as separate 1m and 31m — nothing but 4-bit in a fixture run). Nothing asserts a colour
# key, so only behaviour can notice an upgrade growing a 256-colour
# default or a --colors line creeping into the managed config. The
# managed config is deliberately part of the run (RIPGREP_CONFIG_PATH),
# so a palette-carrying line there fails here too.
if ! command -v rg >/dev/null 2>&1; then
  warn "rg not installed — skipping the rg ANSI-rider check"
elif ! rg_fixture="$(fixture rg)"; then
  warn "$NO_FIXTURE — skipping the rg ANSI-rider check"
else
  printf 'needle here\n' > "$rg_fixture/f.txt"
  rg_out="$(RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config" rg --color=always -n needle "$rg_fixture" 2>/dev/null)"
  rm -rf "$rg_fixture"
  if ! grep -q $'\x1b\[' <<< "$rg_out"; then
    bad "rg emitted no colour at all — the ANSI-rider check has nothing to prove"
  elif grep -qE $'\x1b\[[0-9;]*(38|48);(5|2);' <<< "$rg_out"; then
    bad "rg emitted 256-colour/truecolor SGR codes — no longer riding the 16 ANSI colours (version bump? a --colors line in the managed config?)"
  else
    ok "rg rides the 16 ANSI colours (4-bit output on a fixture match)"
  fi
fi

# The global excludes file is a manifest row; this proves git actually
# CONSULTS it. core.excludesFile unset falls back to the XDG path the row
# deploys, so an override appearing in any scope would silently detach the
# deployed file while every text read stayed green. Negative control: a
# name the file does not list must NOT be ignored, or the probe proved
# nothing about the two that were.
if bare_shim git; then
  warn "git needs the Command Line Tools here (xcode-select --install) — skipping the global-excludes check"
elif ! command -v git >/dev/null 2>&1; then
  :
elif ! ign_fixture="$(fixture ignore)"; then
  warn "$NO_FIXTURE — skipping the global-excludes check"
else
  git -C "$ign_fixture" init -q 2>/dev/null
  mkdir -p "$ign_fixture/.claude"
  touch "$ign_fixture/.DS_Store" "$ign_fixture/.claude/settings.local.json" "$ign_fixture/control.txt"
  if ! git -C "$ign_fixture" check-ignore -q .DS_Store; then
    bad "global excludes: .DS_Store is NOT ignored — git is not consulting the deployed ignore file"
  elif ! git -C "$ign_fixture" check-ignore -q .claude/settings.local.json; then
    bad "global excludes: .claude/settings.local.json is NOT ignored — the **/ pattern no longer matches"
  elif git -C "$ign_fixture" check-ignore -q control.txt; then
    bad "global excludes: the negative control IS ignored — the probe proves nothing"
  else
    ok "global excludes live (.DS_Store and .claude/settings.local.json ignored; control isn't)"
  fi
  rm -rf "$ign_fixture"
fi

# core.fsmonitor is WITHDRAWN (ruled 15-09-2026): a prompt runs git with
# GIT_OPTIONAL_LOCKS=0 and git will not start the daemon under it, so every
# render pays a 1.088s handshake and falls back to the walk — forever, since
# the prompt is the one caller that cannot start what it needs.
# The gitcfg row reads the FILE for the key coming back; this reads git's own
# EFFECTIVE boolean, so `1`, `yes` and `on` are caught too, and so is a value
# arriving from a scope the manifest does not own.
#
# Source-repo only: it asserts this repo owner's decision, not a broken setup,
# and an adopter with a 100k-file monorepo and a daemon already running has
# made a different call correctly. Also scoped to a work tree: without a .git
# (a copy exported without git) `config --get` falls through to the GLOBAL
# scope.
if [ "$SOURCE_REPO" = yes ] && git -C "$REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  if [ "$(git -C "$REPO" config --type=bool --get core.fsmonitor 2>/dev/null)" = "true" ]; then
    bad "core.fsmonitor is true in effect — withdrawn; it costs the prompt 1.088s per repo per boot (preferences.md § Git)"
  else
    ok "core.fsmonitor is not in effect (withdrawn — a prompt cannot start its daemon)"
  fi
fi

# The check below needs a real file at $REPO/<src>: public/shell/zshrc in the
# source repo, shell/zshrc in the flattened public mirror. Deriving the path
# from manifest.tsv, right in both layouts, keeps one script correct in both.
manifest_src_for_target() {
  awk -F'\t' -v t="$1" '$2 == t { print $1; exit }' "$MANIFEST"
}

# z-sy-h must be the last thing that creates or wraps ZLE widgets. `zle -N`
# (and `zle -C`) create widgets directly, without going through `source` or
# `eval` — a `zle -N` line appended below z-sy-h leaves that widget unwrapped,
# which is what this check exists to catch, so it is matched too, not just the
# two ways of pulling in someone else's plugin.
zshrc_src="$(manifest_src_for_target '~/.zshrc')"
if [ -n "$zshrc_src" ] && [ -f "$REPO/$zshrc_src" ]; then
  last_source=$(grep -nE 'source|eval|zle +-[NC]' "$REPO/$zshrc_src" | tail -1)
  if grep -q 'zsh-syntax-highlighting' <<< "$last_source"; then
    ok "zsh-syntax-highlighting is sourced last"
  else
    bad "something is sourced after zsh-syntax-highlighting: $last_source"
  fi
else
  warn "zshrc not found via manifest (~/.zshrc) — skipping z-sy-h ordering check"
fi

# This repo owner's decision: the directory was deleted rather than wired in.
# Source-repo only: the shipped zshrc adds only ~/.docker/completions to
# fpath, so an adopter who HAS this directory could never pass. It also spends
# a second launching an interactive login zsh. `script` fails on a stdin that
# is a socket, an agent's shell, and prints nothing, so its stdin is pinned
# and an empty capture is no answer. macOS's `script` echoes that stdin's EOF
# as `^D` and two backspaces ahead of the capture, so they are stripped before
# it can read as empty. The whole line is matched: inside kitty, fpath also
# holds kitty's own shell-integration/zsh/completions.
if [ "$SOURCE_REPO" = yes ]; then
  if [ -d "$HOME/.zsh/completions" ]; then
    live_fpath="$(script -q /dev/null zsh -l -i -c 'print -l $fpath' </dev/null 2>/dev/null)" || live_fpath=""
    live_fpath="${live_fpath//$'^D\b\b'/}"; live_fpath="${live_fpath//$'\r'/}"
    if [ -z "$live_fpath" ]; then
      warn "could not read fpath from a login zsh — ~/.zsh/completions unchecked"
    elif grep -qxF "$HOME/.zsh/completions" <<< "$live_fpath"; then
      ok "~/.zsh/completions is in fpath"
    else
      bad "~/.zsh/completions exists but is not in fpath"
    fi
  else
    ok "~/.zsh/completions absent (deleted rather than wired in)"
  fi
fi

# compinit must name its dump for the zsh that wrote it: `compinit -C` skips
# the staleness check, so an unversioned dump serves stale completions after a
# zsh upgrade. Read off the managed zshrc, like the z-sy-h check, because a
# dump on disk cannot say which config wrote it: the adopter's old zsh leaves
# an unsuffixed one, and the README runs this before any new zsh has started.
# A -d path passes when it names ZSH_VERSION itself, or is a variable whose
# latest assignment above the call names it — read in line order, as zsh runs
# the file. A call is compinit where a command starts, behind any precommand
# modifier that still runs a function — noglob, nocorrect, exec, `-`; zsh's
# `command` and `builtin` skip functions, so compinit is not called there. An
# assignment is plain or by export, typeset, local, declare or readonly, and
# its value is one word: `a=~/.zcompdump b=$ZSH_VERSION` does not version a.
compinit_calls() { # compinit_calls <zshrc> → "ok|bad<TAB><line>: <code>" per compinit call
  awk '
    function unquote(s) { gsub(/["'\''{};)]/, "", s); return s }
    function word(s,    i, c, q, d) {   # s up to its first unquoted blank, ; & | or ) outside ${…} and $(…)
      q = ""; d = 0
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (q != "") { if (c == q) q = ""; else if (c == "\\" && q == "\"") i++; continue }
        if (c == "\\") { i++; continue }
        if (c == "\"" || c == "'\''") q = c
        else if (c == "(" || c == "{") d++
        else if (d > 0 && (c == ")" || c == "}")) d--
        else if (d == 0 && (c == " " || c == "\t" || c == ";" || c == "&" || c == "|" || c == ")")) break
      }
      return substr(s, 1, i - 1)
    }
    {
      line = $0; sub(/(^|[[:space:]])#.*$/, "", line)
      if (match(line, /^[[:space:]]*((export|typeset|local|declare|readonly)[[:space:]]+(-[a-zA-Z]+[[:space:]]+)*)?[A-Za-z_][A-Za-z_0-9]*=/)) {
        a = substr(line, 1, RLENGTH - 1); sub(/.*[[:space:]]/, "", a)
        if (word(substr(line, RLENGTH + 1)) ~ /ZSH_VERSION/) v[a] = 1; else delete v[a]
      }
      if (!match(line, /(^|[;&|{(]|(^|[[:space:];])(if|elif|then|else|while|until|do|time|!)[[:space:]])[[:space:]]*((noglob|nocorrect|exec|-)[[:space:]]+)*compinit([[:space:];&|)}]|$)/)) next
      rest = substr(line, RSTART); rest = substr(rest, index(rest, "compinit") + 8); sub(/[;&|].*$/, "", rest)
      arg = ""; n = split(rest, w, /[[:space:]]+/)
      for (i = 1; i < n; i++) if (w[i] == "-d") { arg = unquote(w[i + 1]); break }
      ok = (arg ~ /ZSH_VERSION/) || (arg ~ /^\$[A-Za-z_][A-Za-z_0-9]*$/ && (substr(arg, 2) in v))
      code = $0; sub(/^[[:space:]]+/, "", code)
      print (ok ? "ok" : "bad") "\t" NR ": " code
    }
  ' "$1"
}
if [ -n "$zshrc_src" ] && [ -f "$REPO/$zshrc_src" ]; then
  calls="$(compinit_calls "$REPO/$zshrc_src")"
  if [ -z "$calls" ]; then
    warn "found no compinit call in $zshrc_src — the dump-name check read nothing"
  elif grep -q '^bad' <<< "$calls"; then
    while IFS=$'\t' read -r verdict call; do
      if [ "$verdict" = bad ]; then
        bad "$zshrc_src:$call — its dump is not named for \$ZSH_VERSION, so a zsh upgrade can serve stale completions"
      fi
    done <<< "$calls"
  else
    ok "every compinit call names its dump for \$ZSH_VERSION"
  fi
else
  warn "zshrc not found via manifest (~/.zshrc) — skipping the dump-name check"
fi
# Never a FAIL: nothing in this setup reads that file.
if [ -e "$HOME/.zcompdump" ]; then
  warn "~/.zcompdump is not this setup's dump — left by an earlier zsh config (rm ~/.zcompdump), or something outside the managed zshrc still calls compinit without -d"
fi

# kitty starts every tab through /usr/bin/login (`login -f -l -p $USER …`,
# read off the process table), and login prints "Last login: …" until
# ~/.hushlogin exists — a manifest row. The row proves the file is deployed;
# this proves the mechanism the file exists for is the one in play, so the
# pair says "a new tab opens at the prompt". The effect was proven once, both
# ways, with kitty's exact invocation under a PTY; it is NOT re-run here
# because every `login -f` leaves a utmpx record. Silent when kitty is not
# running — the mirror's CI, or a Mac with no tab open.
# $USER is unset under `env -i` (a sandboxed test, cron, a container), and
# under `set -u` reading it would abort every check below. No $USER, no kitty
# tab to ask about: silent, like kitty not running.
if [ -n "${USER:-}" ] && pgrep -qf "/usr/bin/login -f -l -p $USER " 2>/dev/null; then
  if [ -f "$HOME/.hushlogin" ]; then
    ok "kitty tabs start through login, and ~/.hushlogin keeps the banner off"
  else
    bad "kitty tabs start through login and ~/.hushlogin is missing — every new tab opens under a 'Last login' banner"
  fi
fi

# The public mirror must not silently fall behind. Honours $PREEN_MIRROR, the
# same override preen publish accepts — a doctor that checks a different
# path than the tool that maintains it is its own drift.
# The checks from here through the hosts/*/doctor.d/ loop are SOURCE-REPO
# ONLY: this script ships, but what they read — publish/.last-published,
# bin/lib/stage-mirror.sh, docs/blocked-upstream.md, .githooks/,
# hosts/*/doctor.d/ — exists only here, and the gh account check guards this
# repo's own gh operations.
if [ "$SOURCE_REPO" = yes ]; then
  source "$REPO/bin/lib/stage-mirror.sh"   # here, not at the top: it does not ship
  MIRROR="${PREEN_MIRROR:-$HOME/Development/preen}"
  if [ -d "$MIRROR/.git" ] && [ ! -f "$REPO/publish/.last-published" ]; then
    warn "publish/.last-published is missing — whether the public mirror is current goes unchecked"
  elif [ -d "$MIRROR/.git" ]; then
    here=$(mirror_fingerprint "$REPO" 2>/dev/null || echo none)
    marker=$(cat "$REPO/publish/.last-published" 2>/dev/null || echo none)
    if [ "$here" = "$marker" ]; then
      ok "public mirror is current"
    else
      warn "what HEAD ships has changed since the last publish — run preen publish"
    fi
  else
    warn "public mirror not cloned at $MIRROR"
  fi

  # The expected account is DERIVED from origin, never hardcoded, so the check
  # holds in anyone's clone.
  origin_url=$(git -C "$REPO" remote get-url origin 2>/dev/null || echo '')
  expected_owner=$(printf '%s' "$origin_url" | sed -E 's#.*[:/]([^/]+)/[^/]+$#\1#')
  if [ -z "$expected_owner" ] || [ "$expected_owner" = "$origin_url" ]; then
    warn "could not derive the expected gh account from origin ('${origin_url:-unset}') — check manually"
  elif grep -q "$expected_owner" <<< "$(gh auth status 2>&1 | grep -B1 'Active account: true')"; then
    ok "gh active account is $expected_owner"
  else
    warn "gh active account is NOT $expected_owner — repo operations would hit the wrong account"
  fi
fi

# A deferral must not become permanent by neglect.
if [ "$SOURCE_REPO" = no ]; then
  :
elif [ ! -f "$REPO/docs/blocked-upstream.md" ]; then
  warn "docs/blocked-upstream.md is missing — the cship deferral it records goes unchecked"
else
  installed=$("$HOME/.cargo/bin/cship" --version 2>/dev/null | awk '{print $NF}')
  broken=$(awk -F'`' '/cship.*broken at/{print $2; exit}' "$REPO/docs/blocked-upstream.md")
  # An unparseable state (cship missing/erroring, or the awk pattern failing
  # to match blocked-upstream.md's prose) warns: an "ok" there would assert
  # something never checked.
  if [ -z "$installed" ] || [ -z "$broken" ]; then
    warn "could not determine cship version or blocked-upstream entry (installed='${installed:-?}' recorded='${broken:-?}') — re-check manually"
  elif [ "$installed" != "$broken" ]; then
    warn "cship is $installed, recorded broken at $broken — re-check cship#194"
  else
    ok "blocked-upstream entries unchanged"
  fi
fi

# The pre-commit hook (glyph integrity, TOML parse) is opt-in PER CLONE via
# `git config core.hooksPath .githooks`; this warns on a clone that has not
# opted in. The mirror ships none.
if [ "$SOURCE_REPO" = no ]; then
  :
elif [ ! -d "$REPO/.githooks" ]; then
  warn ".githooks/ is missing — the pre-commit hook this clone opts into is not there"
else
  hooks_path="$(git -C "$REPO" config --get core.hooksPath 2>/dev/null || true)"
  if [ "$hooks_path" = ".githooks" ]; then
    ok "pre-commit hooks enabled (core.hooksPath=.githooks)"
  else
    warn "pre-commit hooks NOT enabled — run: git -C \"$REPO\" config core.hooksPath .githooks (found '${hooks_path:-unset}')"
  fi
fi

# Machine-specific checks that cannot be published. Each module prints its own
# heading and calls ok/bad/warn from this scope; nothing here registers or
# enumerates them, so adding one is adding a file. The extension point is
# generic on purpose: a check written inline would ship in the mirror and
# describe a private setup's shape, which no scan for secret strings catches.
# An adopter's clone runs none, whatever hosts/ it grows.
# Each module prints its own heading for the same reason run_pref_checks does:
# a heading printed here would leave a bare section with nothing under it.
if [ "$SOURCE_REPO" = yes ]; then
  _found=no
  for _mod in "$REPO"/hosts/*/doctor.d/*.sh; do
    if [ -f "$_mod" ]; then _found=yes; source "$_mod"; fi
  done
  [ "$_found" = yes ] || warn "no hosts/*/doctor.d/*.sh — the machine-specific checks did not run"
  unset _mod _found
fi

# Asserts the preference spec against LIVE config — what the applications
# actually render, not what this repo believes they were given. The manifest
# checks above prove deployment; these prove the deployed values are the ones
# the spec names. Two different questions: a copy-mode file can match the repo
# perfectly and still carry a value the spec never sanctioned.
# The header is printed by run_pref_checks itself, after its own guard: printed
# here, it would leave a bare heading where the checkout has no spec — a
# section that looks broken rather than absent.
# Outside the source repo the spec is the author's taste, asserted only when
# asked for (--taste): an adopter's correct setup is not failed over it.
if declare -f run_pref_checks >/dev/null 2>&1 && { [ "$SOURCE_REPO" = yes ] || [ "$TASTE" = yes ]; }; then
  run_pref_checks "$REPO" || FAILED=1
fi

echo "--"
[ "$FAILED" -eq 0 ] && echo "no failures" || echo "FAILURES ABOVE"
exit "$FAILED"
