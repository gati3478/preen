#!/usr/bin/env bash
# Deploy per manifest.tsv. Idempotent.
#
# Modes:
#   link  a symlink into the repo — editing the repo IS editing the live file
#   copy  the application rewrites this file itself, so it is copied and
#         reconciled by dot-pull rather than linked
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="$REPO/manifest.tsv"
DRY_RUN="${1:-}"

# The manifest installs USER files: ~/.zshrc, ~/.config, ~/.local. Running as
# root would create root-owned files in a user's home, which then fail to be
# rewritten by the tools that own them.
if [ "$(id -u)" -eq 0 ]; then
  echo "dot-apply: refusing to run as root — this installs user files" >&2
  exit 1
fi

expand() { printf '%s' "${1/#\~/$HOME}"; }
# The other direction, for printing. `${1/#$HOME/\~}` keeps the backslash in
# bash — the same trap public/prompt/install.sh names — so a first run said
# `CREATED DIR     \~/.config/kitty` once per directory it made (14-09-2026).
short() {
  case "$1" in
    "$HOME"|"$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# Counted before the loop so the exit trap can report progress against it.
expected_rows=$(awk -F'\t' '$1 !~ /^($|#)/ { c++ } END { print c+0 }' "$MANIFEST")

# set -e stops this script the moment an ln or cp fails — on a read-only
# directory, say. The failing command printed its own error, but nothing said
# that some rows had been deployed and the rest had not, or what to do about
# it. Every row is idempotent, so the useful thing to say is how far it got
# and that running it again finishes the job — which is true of a row that
# failed, and NOT of the structural refusals below, which repeat until the
# manifest itself is fixed.
applied=0
rows_seen=0
stop_advice=yes
on_exit() {
  local rc=$?
  if [ "$rc" -ne 0 ] && [ "$applied" -gt 0 ] && [ "$stop_advice" = yes ]; then
    echo "--" >&2
    echo "dot-apply: stopped after $applied of $expected_rows entries. Fix what is reported above and run it again — every row is idempotent, so a re-run continues rather than repeating." >&2
  fi
  return "$rc"
}
trap on_exit EXIT
while IFS=$'\t' read -r src tgt mode perms; do
  case "$src" in ''|'#'*) continue ;; esac
  rows_seen=$((rows_seen + 1))
  abs_src="$REPO/$src"
  abs_tgt="$(expand "$tgt")"

  if [ ! -e "$abs_src" ]; then
    echo "MISSING SOURCE  $src" >&2
    exit 1
  fi

  # Never clobber a real directory. A file we can back up; a populated
  # directory is someone else's data.
  if [ -d "$abs_tgt" ] && [ ! -L "$abs_tgt" ]; then
    echo "REFUSING        $tgt is a real directory" >&2
    exit 1
  fi

  if [ -n "$DRY_RUN" ]; then
    echo "would $mode      $tgt"
    continue
  fi

  # Creating a parent is legitimate on a fresh machine, but it must never be
  # SILENT. Version-pinned targets (the IDEA rows carry `IntelliJIdea2026.2`)
  # would otherwise let a stale path resurrect itself after a major upgrade:
  # mkdir -p happily recreates the dead directory, cp succeeds, the run reports
  # "N entries applied", and the config the IDE actually reads never receives
  # anything. Announcing the creation is what turns that from silent into
  # visible — an unexpected line here means a manifest path has gone stale.
  tgt_dir="$(dirname "$abs_tgt")"
  if [ ! -d "$tgt_dir" ]; then
    echo "CREATED DIR     $(short "$tgt_dir")" >&2
    mkdir -p "$tgt_dir"
  fi

  case "$mode" in
    link)
      # Back up a pre-existing REGULAR file before replacing it with a link.
      if [ -f "$abs_tgt" ] && [ ! -L "$abs_tgt" ]; then
        # Under a name nothing holds yet: a second plain file here — a tool
        # replaced the link — must not overwrite the first run's backup.
        bak="$abs_tgt.pre-dotfiles"; n=1
        while [ -e "$bak" ] || [ -L "$bak" ]; do bak="$abs_tgt.pre-dotfiles.$n"; n=$((n + 1)); done
        cp "$abs_tgt" "$bak"
        echo "backed up       $tgt -> $tgt${bak#"$abs_tgt"}"
      elif [ -L "$abs_tgt" ] && [ ! "$abs_tgt" -ef "$abs_src" ]; then
        # An adopter coming from stow, chezmoi or yadm has SYMLINKS here, not
        # plain files, and this branch replaced them without a word — the file
        # they pointed at survived, but nothing recorded where that was.
        # Saying it is the whole fix: there is nothing to copy, only to name.
        echo "replaced link   $tgt (was -> $(readlink "$abs_tgt"))"
      fi
      ln -sfn "$abs_src" "$abs_tgt"
      ;;
    copy)
      # `cp` FOLLOWS a symlink, so a link already sitting here was written
      # straight through and whatever it pointed at — an adopter's own file,
      # outside everything this manifest manages — was destroyed. The link
      # still read as a link afterwards and every check still said ok, so
      # nothing anywhere showed it (found 14-09-2026, on 8 of 30 rows). Move
      # the link aside, link and all, as the statusline drop-in's place() does.
      if [ -L "$abs_tgt" ]; then
        bak="$abs_tgt.pre-dotfiles"; n=1
        while [ -e "$bak" ] || [ -L "$bak" ]; do bak="$abs_tgt.pre-dotfiles.$n"; n=$((n + 1)); done
        mv "$abs_tgt" "$bak"
        echo "moved aside     $tgt (a symlink -> $(readlink "$bak"))"
      elif [ -f "$abs_tgt" ] && ! cmp -s "$abs_src" "$abs_tgt"; then
        # A plain file here is the adopter's own, or the application's rewrite
        # of an earlier copy, and it was overwritten with no backup — a cold
        # reader of the mirror's page closed the tab on that (22-09-2026). The
        # link row's rule: kept beside itself, under a name nothing holds yet;
        # identical content is left alone, so a re-run backs up nothing.
        bak="$abs_tgt.pre-dotfiles"; n=1
        while [ -e "$bak" ] || [ -L "$bak" ]; do bak="$abs_tgt.pre-dotfiles.$n"; n=$((n + 1)); done
        cp "$abs_tgt" "$bak"
        echo "backed up       $tgt -> $tgt${bak#"$abs_tgt"}"
      fi
      cp "$abs_src" "$abs_tgt"
      ;;
    *)
      echo "UNKNOWN MODE    $mode for $src" >&2
      exit 1
      ;;
  esac

  [ -n "${perms:-}" ] && chmod "$perms" "$abs_tgt"
  echo "$mode            $tgt"
  applied=$((applied + 1))
done < "$MANIFEST"

# Guards the classic `while read` gotcha (same fix as dot-doctor/dot-pull):
# a manifest missing its trailing newline silently drops its last row from
# this loop entirely — `read` still populates the row's variables but
# returns non-zero on that final line, so the loop condition fails before
# the body runs. dot-apply is the tool that actually DEPLOYS the manifest;
# unlike dot-doctor (verifies) and dot-pull (reconciles copy-mode files),
# a silent short-deploy here means a stale symlink or missing file stays
# live with no error and an "N entries applied" count that looks correct.
if [ "$rows_seen" -ne "$expected_rows" ]; then
  stop_advice=no   # the loop finished; a re-run repeats this, it does not continue
  echo "dot-apply: refusing — processed $rows_seen manifest row(s) but $MANIFEST has $expected_rows — a row was silently skipped (missing trailing newline?)" >&2
  exit 1
fi

echo "--"
echo "$applied entries applied"
