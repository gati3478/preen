#!/usr/bin/env bash
# Deploy per manifest.tsv. Idempotent.
#
# Modes:
#   link  a symlink into the repo — editing the repo IS editing the live file
#   copy  a plain copy, for a file that must not be a symlink, such as one the
#         application rewrites itself
set -euo pipefail

usage() { cat <<'EOF'
usage: preen apply [--dry-run]

Deploys every manifest.tsv row: a link row as a symlink into this repo, a copy
row as a copy; a plain file it replaces is backed up beside itself. Every
refusal comes before the first write. Never runs as root.

  --dry-run   refuse as a real run would, then print each line the real run
              would, worded "would …"; write nothing
  -h, --help  print this and exit
EOF
}
for arg in "$@"; do
  case "$arg" in -h|--help) usage; exit 0 ;; esac
done
DRY_RUN=""
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=yes ;;
    *) echo "preen apply: unknown argument: $arg (see --help)" >&2; exit 2 ;;
  esac
done

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="$REPO/manifest.tsv"

# The manifest installs USER files: ~/.zshrc, ~/.config, ~/.local. Running as
# root would create root-owned files in a user's home, which then fail to be
# rewritten by the tools that own them.
if [ "$(id -u)" -eq 0 ]; then
  echo "preen apply: refusing to run as root — this installs user files" >&2
  exit 1
fi

# For printing, HOME as ~: bash 3.2 keeps the backslash in `${1/#$HOME/\~}`,
# printing `\~/.config/kitty`, so the prefix is matched instead.
short() {
  case "$1" in
    "$HOME"|"$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# Walks from HOME down to a target's directory and stops at the first of:
#   link        a symlinked directory: a tree something else manages (stow
#               folds a whole package into one link), and every write under it
#               lands there, so tracked files in the adopter's dotfiles repo
#               become links into this clone;
#   notdir      a file where a directory must be;
#   unwritable  the deepest directory that exists, where the write, or the
#               mkdir -p before it, lands.
# HOME is never tested for a link; a home reached through a link is still the
# home. Fork-free, the answer in PROBLEM and PROBLEM_AT rather than on stdout,
# because it runs for every row on every run.
parent_problem() { # parent_problem <abs target> → PROBLEM (link|notdir|unwritable), PROBLEM_AT
  local home="${HOME%/}" rel p next
  PROBLEM="" PROBLEM_AT=""
  rel="${1#"$home"/}"
  [ "$rel" != "$1" ] || return 1
  case "$rel" in */*) rel="${rel%/*}" ;; *) rel="" ;; esac
  p="$home"
  while [ -n "$rel" ]; do
    next="$p/${rel%%/*}"
    if [ -L "$next" ]; then PROBLEM="link"; PROBLEM_AT="$next"; return 0; fi
    [ -e "$next" ] || break
    if [ ! -d "$next" ]; then PROBLEM="notdir"; PROBLEM_AT="$next"; return 0; fi
    p="$next"
    case "$rel" in */*) rel="${rel#*/}" ;; *) rel="" ;; esac
  done
  if [ ! -w "$p" ] || [ ! -x "$p" ]; then PROBLEM="unwritable"; PROBLEM_AT="$p"; return 0; fi
  return 1
}

expected_rows=$(awk -F'\t' '$1 !~ /^($|#)/ { c++ } END { print c+0 }' "$MANIFEST")

# Every refusal comes before the first write, the promise the drop-ins make: a
# refusal inside the deploy loop would stop a run with the rows before it
# deployed and the rest not. A dry run refuses exactly as a real run would.
refused=no
named=$'\n'
rows_seen=0
while IFS=$'\t' read -r src tgt mode perms; do
  case "$src" in ''|'#'*) continue ;; esac
  rows_seen=$((rows_seen + 1))
  # Not `${tgt/#\~/$HOME}`: bash 5.2 reads an `&` in HOME as the matched `~`.
  case "$tgt" in '~'|'~/'*) abs_tgt="$HOME${tgt#\~}" ;; *) abs_tgt="$tgt" ;; esac

  if [ ! -e "$REPO/$src" ]; then
    echo "MISSING SOURCE  $src" >&2
    refused=yes
  elif [ "$mode" = link ] && [ -n "$perms" ] && [ ! -O "$REPO/$src" ]; then
    # chmod reaches through the link to the clone's file, which only its owner
    # may change.
    echo "REFUSING        $(short "$REPO/$src") is owned by another user, and this row sets its mode to $perms" >&2
    refused=yes
  fi

  case "$mode" in
    link|copy) ;;
    *) echo "UNKNOWN MODE    $mode for $src" >&2; refused=yes ;;
  esac

  # Never clobber a real directory. A file we can back up; a populated
  # directory is someone else's data.
  if [ -d "$abs_tgt" ] && [ ! -L "$abs_tgt" ]; then
    echo "REFUSING        $tgt is a real directory" >&2
    refused=yes
  elif [ -f "$abs_tgt" ] && [ ! -L "$abs_tgt" ]; then
    # A plain file is read to be backed up, and a copy row writes it in place.
    if [ ! -r "$abs_tgt" ]; then
      echo "REFUSING        $tgt is not readable, so it cannot be backed up" >&2
      refused=yes
    elif [ "$mode" = copy ] && [ ! -w "$abs_tgt" ]; then
      echo "REFUSING        $tgt is not writable, and this copy row writes it in place" >&2
      refused=yes
    fi
  fi

  # Named once, however many rows sit under it: the first write under it would
  # already land there, or fail.
  if parent_problem "$abs_tgt"; then
    case "$named" in
      *$'\n'"$PROBLEM_AT"$'\n'*) ;;
      *)
        named="$named$PROBLEM_AT"$'\n'
        case "$PROBLEM" in
          link)       why="is a symlink to $(readlink "$PROBLEM_AT") — the rows under it would land in a directory something else manages" ;;
          notdir)     why="is not a directory — the rows under it need one there" ;;
          unwritable) why="is not writable — the rows under it would fail there" ;;
        esac
        echo "REFUSING        $(short "$PROBLEM_AT") $why" >&2
        refused=yes
        ;;
    esac
  fi
done < "$MANIFEST"

# A manifest missing its trailing newline drops its last row from a while-read
# loop: `read` fills the row's variables but returns non-zero on that line.
# Here that would leave a stale link or a missing file live under "every row
# applied".
if [ "$rows_seen" -ne "$expected_rows" ]; then
  echo "preen apply: refusing — a row of $(short "$MANIFEST") was silently skipped (missing trailing newline?)" >&2
  refused=yes
fi

if [ "$refused" = yes ]; then
  echo "preen apply: nothing was written — fix what is reported above and run it again" >&2
  exit 1
fi

# set -e stops this script the moment an ln or cp fails — on a disk that
# fills, say. The failing command prints its own error, not that the rows
# before it are deployed and the rest are not. Every row is idempotent, so
# on_exit names the row it stopped at and says a re-run finishes the job.
row=""
on_exit() {
  local rc=$?
  if [ "$rc" -ne 0 ] && [ -n "$row" ]; then
    echo "--" >&2
    echo "preen apply: stopped at $row; the rows before it are deployed. Fix what is reported above and run it again: every row is idempotent, so a re-run continues." >&2
  fi
  return "$rc"
}
trap on_exit EXIT

# A dry run walks the same branches and writes nothing: every write but the
# parent mkdir goes through run, and say words each line as what the run
# would do.
run() { [ -n "$DRY_RUN" ] || "$@"; }
say() { # say <real-run words> <dry-run words> <facts>, the words padded to one column
  if [ -n "$DRY_RUN" ]; then printf '%-15s %s\n' "$2" "$3"; else printf '%-15s %s\n' "$1" "$3"; fi
}
# A dry run makes no directory, so it records each mkdir -p it would run: a
# later row finds that directory, and every one above it, already there.
made=$'\n'
dry_made() { case "$made" in *$'\n'"$1"$'\n'*|*$'\n'"$1"/*) return 0 ;; esac; return 1; }

# Every writer in this setup, the drop-ins included, names a backup
# <file>.unpreened.<stamp>, the stamp taken once per run, so a file's backups
# sort by time whichever of them wrote each. A dry run cannot know the real
# run's second, so it names the stamp instead.
if [ -n "$DRY_RUN" ]; then STAMP='<stamp>'; else STAMP="$(date +%Y%m%d-%H%M%S)"; fi
backup_name() { # backup_name <file> → a name beside it that nothing holds yet
  local b="$1.unpreened.$STAMP" n=1
  while [ -e "$b" ] || [ -L "$b" ]; do
    b="$1.unpreened.$STAMP.$n"
    n=$((n + 1))
  done
  printf '%s' "$b"
}

while IFS=$'\t' read -r src tgt mode perms; do
  case "$src" in ''|'#'*) continue ;; esac
  abs_src="$REPO/$src"
  case "$tgt" in '~'|'~/'*) abs_tgt="$HOME${tgt#\~}" ;; *) abs_tgt="$tgt" ;; esac
  [ -n "$DRY_RUN" ] || row="$tgt"

  # Creating a parent is legitimate on a fresh machine, but it must never be
  # SILENT. Version-pinned targets (a JetBrains config directory such as
  # `IntelliJIdea2026.2`) would otherwise let a stale path resurrect itself
  # after a major upgrade: mkdir -p happily recreates the dead directory, cp
  # succeeds, the run reports every row applied, and the config the IDE
  # actually reads never receives anything. Announcing the creation is what
  # turns that from silent into visible — an unexpected line here means a
  # manifest path has gone stale.
  tgt_dir="$(dirname "$abs_tgt")"
  if [ ! -d "$tgt_dir" ] && ! dry_made "$tgt_dir"; then
    if [ -n "$DRY_RUN" ]; then
      echo "would create dir $(short "$tgt_dir")"
      made="$made$tgt_dir"$'\n'
    else
      echo "CREATED DIR     $(short "$tgt_dir")" >&2
      mkdir -p "$tgt_dir"
    fi
  fi

  # bootstrap reads the "backed up", "moved aside" and "replaced link" lines
  # below by their padded prefixes, and a dry run's "would back up", "would
  # move aside" and "would replace link": reword one and its closing lines
  # drop the file it names.
  case "$mode" in
    link)
      # Back up a pre-existing REGULAR file before replacing it with a link.
      if [ -f "$abs_tgt" ] && [ ! -L "$abs_tgt" ]; then
        # Under a name nothing holds yet: a second plain file here — a tool
        # replaced the link — must not overwrite the first run's backup.
        bak="$(backup_name "$abs_tgt")"
        run cp "$abs_tgt" "$bak"
        say 'backed up' 'would back up' "$tgt -> $tgt${bak#"$abs_tgt"}"
      elif [ -L "$abs_tgt" ] && [ ! "$abs_tgt" -ef "$abs_src" ]; then
        # An adopter coming from stow, chezmoi or yadm has symlinks here, not
        # plain files. Replacing one loses only where it pointed, so the line
        # names that; there is nothing to copy.
        say 'replaced link' 'would replace link' "$tgt (was -> $(readlink "$abs_tgt"))"
      fi
      run ln -sfn "$abs_src" "$abs_tgt"
      ;;
    copy)
      # `cp` follows a symlink: copying over a link here would overwrite what it
      # points at, an adopter's own file outside this manifest, while the link
      # still reads as a link and every check says ok. Move the link aside,
      # link and all, as the drop-ins' shared place() does.
      if [ -L "$abs_tgt" ]; then
        bak="$(backup_name "$abs_tgt")"
        was="$(readlink "$abs_tgt")"
        run mv "$abs_tgt" "$bak"
        say 'moved aside' 'would move aside' "$tgt (a symlink -> $was)"
      elif [ -f "$abs_tgt" ] && ! cmp -s "$abs_src" "$abs_tgt"; then
        # A plain file here is the adopter's own, or the application's rewrite
        # of an earlier copy, so it is kept beside itself under a name nothing
        # holds yet, as for a link row; identical content is left alone, so a
        # re-run backs up nothing.
        bak="$(backup_name "$abs_tgt")"
        run cp "$abs_tgt" "$bak"
        say 'backed up' 'would back up' "$tgt -> $tgt${bak#"$abs_tgt"}"
      fi
      run cp "$abs_src" "$abs_tgt"
      ;;
  esac

  [ -n "${perms:-}" ] && run chmod "$perms" "$abs_tgt"
  say "$mode" "would $mode" "$tgt"
  row=""
done < "$MANIFEST"

echo "--"
if [ -n "$DRY_RUN" ]; then
  echo "Nothing was written. Drop --dry-run to do it."
else
  echo "every row applied"
fi
