#!/usr/bin/env bash
# Adopt this setup on a fresh machine.
#
# Asks for the values that are personal, sets them in a local
# overlay, symlinks everything in the manifest into place (preen apply owns
# that, backups included), and finally writes the one value kitty's config
# language cannot template into ~/.config/kitty/tab-title.conf. Nothing it does
# touches this clone. Never runs as root.
set -euo pipefail

usage() { cat <<'EOF'
usage: ./bin/bootstrap [--dry-run]

Takes the whole setup from this clone: names what is missing, asks your name
and email for git and sets them in ~/.gitconfig.local, deploys every row of
manifest.tsv through preen apply, and writes kitty's tab title for your home.

  --dry-run   print the whole plan; asks nothing and writes nothing
  -h, --help  print this and exit

Before the deploy, a plain ~/.gitconfig of yours moves to ~/.gitconfig.local
and ~/.ssh/config to ~/.ssh/config.local, unless that .local is there or the
file names it: the shipped files include those overlays, so every line of
yours still wins. A ~/.gitconfig that names the git piece's copy,
~/.config/git/preen/gitconfig, is not moved either: the copy includes
~/.gitconfig.local, so moved there it would include itself. Every refusal,
its own or preen apply's, comes before the first write. It ends by naming
the overlays, each yours and read with a shipped file, and every file this
run set aside.
EOF
}
# --help anywhere wins, even after an argument that is not one.
for arg in "$@"; do
  case "$arg" in -h|--help) usage; exit 0 ;; esac
done
dry_run=no
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=yes ;;
    *) echo "bootstrap: unknown argument: $arg (see --help)" >&2; exit 2 ;;
  esac
done
# A dry run makes no write and says what each step would do: run makes a
# write, and tell picks a line's words, as done or as planned.
run() { [ "$dry_run" = yes ] || "$@"; }
tell() { if [ "$dry_run" = yes ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

# Every writer in this setup, preen apply and the drop-ins included, names a
# backup <file>.unpreened.<stamp>, the stamp taken once per run, so a file's
# backups sort by time whichever of them wrote each. A dry run cannot know the
# real run's second, so it names the stamp instead.
if [ "$dry_run" = yes ]; then STAMP='<stamp>'; else STAMP="$(date +%Y%m%d-%H%M%S)"; fi
backup_name() { # backup_name <file> → a name beside it that nothing holds yet
  local b="$1.unpreened.$STAMP" n=1
  while [ -e "$b" ] || [ -L "$b" ]; do
    b="$1.unpreened.$STAMP.$n"
    n=$((n + 1))
  done
  printf '%s' "$b"
}

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Apple silicon's Homebrew prefix, then Intel's: shell/zprofile's order.
BREW_PREFIXES="/opt/homebrew /usr/local"

if [ "$(id -u)" -eq 0 ]; then
  echo "bootstrap: refusing to run as root — this installs user files" >&2
  exit 1
fi

# Answers arrive on plain stdin: this is run from a clone, so stdin is the
# terminal. At end of input `read` returns non-zero; a pipe or `</dev/null`
# gets a stated stop, not a silent `set -e` exit.
ask() { # ask <prompt> <variable> — the line typed, trimmed, or a stated stop
  local _line
  printf '%s' "$1"
  if ! IFS= read -r _line; then
    printf '\nbootstrap: no answer on stdin — run it from a terminal, in a clone: ./bin/bootstrap\n' >&2
    exit 1
  fi
  # Trimmed, so `  y  ` at a [y/N] prompt still matches the glob.
  _line="${_line#"${_line%%[![:space:]]*}"}"
  _line="${_line%"${_line##*[![:space:]]}"}"
  eval "$2=\$_line"
}
ask_required() { # ask_required <prompt> <variable> — re-asks rather than accept a blank
  while :; do
    ask "$1" "$2"
    eval "[ -n \"\$$2\" ]" && return
    # git accepts `name = ` in a config file and refuses only at the first
    # commit ("empty ident name (for <>) not allowed").
    echo "  that cannot be empty — git refuses to commit without it" >&2
  done
}

# A Mac without the Command Line Tools still has /usr/bin/git and
# /usr/bin/python3: stubs that raise an install dialog when run. So the tool
# behind the stub is looked for, never run; `xcode-select -p` alone is not
# enough, it prints a stale selection and exits 0.
bare_shim() { # bare_shim <tool> → true when <tool> is macOS's /usr/bin stub with no developer tools behind it
  local dir
  [ "$(command -v "$1" 2>/dev/null)" = "/usr/bin/$1" ] && [ -x /usr/bin/xcode-select ] || return 1
  dir="$(/usr/bin/xcode-select -p 2>/dev/null)" && [ -x "$dir/usr/bin/$1" ] && return 1
  return 0
}

# preen apply refuses before its first write, but this run writes before it
# calls preen apply — the identity, the ssh move — and after it, the tab title.
# So its own refusals and preen apply's all come first, and a refused run has
# changed nothing. The identity is set by key in ~/.gitconfig.local, and a key
# set through a symlink lands in the file it points at.
GITCONFIG_LOCAL="$HOME/.gitconfig.local"
GITCONFIG="$HOME/.gitconfig"
# The git piece's copy of the shipped gitconfig, under ~. Like the shipped
# file, it includes ~/.gitconfig.local.
GIT_PIECE_COPY=".config/git/preen/gitconfig"
# The tab title is written for any home but the one kitty.conf's line names.
AUTHORED_HOME="/Users/gati3478"
KITTY_CONF="$REPO/terminal/kitty/kitty.conf"
TAB_TITLE_AWK="$REPO/terminal/kitty/tab-title.awk"   # the kitty drop-in runs it too
TAB_TITLE_CONF="$HOME/.config/kitty/tab-title.conf"
# Read as text: git may be the Command Line Tools stub. A path is printed as
# git reads the value — quotes dropped, a comment cut — and an include section
# counts from its header's own line, `[include] path = …`, as git's does.
git_includes() { # git_includes <file> → each include and includeIf path in it, as <line><tab><value>
  awk '
    function gitval(s,    v, q, c, i, sp) {
      v = ""; q = 0; sp = 0
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (!q && (c == " " || c == "\t")) { if (v != "") sp++; continue }
        if (!q && (c == "#" || c == ";")) break
        for (; sp > 0; sp--) v = v " "
        if (c == "\"") { q = !q; continue }
        if (c == "\\") { c = substr(s, ++i, 1); if (c == "t") c = "\t" }
        v = v c
      }
      return v
    }
    /^[ \t]*\[/ {
      e = index($0, "]"); hdr = tolower(substr($0, 1, e)); rest = substr($0, e + 1)
      inc = (hdr ~ /^[ \t]*\[[ \t]*include[ \t]*\]$/ || hdr ~ /^[ \t]*\[[ \t]*includeif[ \t]/)
    }
    !/^[ \t]*\[/ { rest = $0 }
    inc && tolower(rest) ~ /^[ \t]*path[ \t]*=/ { v = rest; sub(/^[^=]*=/, "", v); print NR "\t" gitval(v) }
  ' "$1"
}
refused=no
if [ -L "$GITCONFIG_LOCAL" ]; then
  echo "bootstrap: ~/.gitconfig.local is a symlink to $(readlink "$GITCONFIG_LOCAL") — set user.name and user.email in that file yourself, or replace the link with a file" >&2
  refused=yes
elif [ -e "$GITCONFIG_LOCAL" ] && [ ! -f "$GITCONFIG_LOCAL" ]; then
  echo "bootstrap: ~/.gitconfig.local is not a file — the identity is set in it, and the shipped ~/.gitconfig includes it" >&2
  refused=yes
elif [ -e "$GITCONFIG_LOCAL" ] && [ ! -r "$GITCONFIG_LOCAL" ]; then
  echo "bootstrap: ~/.gitconfig.local is not readable — the identity is set in it, and the shipped ~/.gitconfig includes it" >&2
  refused=yes
elif [ -e "$GITCONFIG_LOCAL" ]; then
  # The shipped ~/.gitconfig includes ~/.gitconfig.local, so an include of
  # ~/.gitconfig there is a loop, and git stops every command on it; so is an
  # include of the git piece's copy, which includes ~/.gitconfig.local in turn.
  # git_includes reads each include and includeIf path, and an includeIf is a
  # loop the moment its condition holds. The path is then resolved as git
  # resolves it: a leading ~ or ~<this user> expanded, a relative path taken
  # against this file's directory, which is ~, no variable expanded, and any
  # spelling of the directory followed to the real one, a `..` after a link
  # taken from where the link points. A link is followed by
  # name, each relative target taken against the link's own directory, for a
  # bounded number of hops, so a cycle of links ends. A link to ~/.gitconfig
  # is the same loop even while it dangles, since the deploy writes that name,
  # and so is the clone's git/gitconfig, which ~/.gitconfig becomes a link to.
  # What ~/.gitconfig is before the run is not compared: the deploy replaces
  # it, so in a stow home, where it links to ~/dotfiles/gitconfig, an include
  # of that file is kept. The copy is compared by name too, its directory
  # resolved as a path's is; where that directory is not, there is no copy.
  tab="$(printf '\t')"
  home_gitconfig="$(cd -P "$HOME" && pwd -P)/.gitconfig"
  piece_copy=""
  piece_dir="$(cd -P "$HOME/${GIT_PIECE_COPY%/*}" 2>/dev/null && pwd -P)" && piece_copy="$piece_dir/${GIT_PIECE_COPY##*/}"
  me="$(id -un 2>/dev/null)" || me=""
  loop=""
  while IFS= read -r inc; do
    [ -n "$inc" ] || continue
    n="${inc%%"$tab"*}"; p="${inc#*"$tab"}"
    case "$p" in
      "~/"*) p="$HOME/${p#"~/"}" ;;
      "~$me/"*) p="$HOME/${p#"~$me/"}" ;;
      /*) ;;
      *) p="$HOME/$p" ;;
    esac
    hops_left=40
    while [ -z "$loop" ] && [ "$hops_left" -gt 0 ]; do
      dir="${p%/*}"
      dir="$(cd -P "${dir:-/}" 2>/dev/null && pwd -P)" || break
      p="$dir/${p##*/}"
      if [ "$p" = "$home_gitconfig" ] || [ "$p" -ef "$REPO/git/gitconfig" ]; then
        loop="line $n includes ~/.gitconfig ($(sed -n "${n}{s/^[[:space:]]*//;p;}" "$GITCONFIG_LOCAL"))"
      elif [ -n "$piece_copy" ] && [ "$p" = "$piece_copy" ]; then
        loop="line $n includes ~/$GIT_PIECE_COPY ($(sed -n "${n}{s/^[[:space:]]*//;p;}" "$GITCONFIG_LOCAL")), the git piece's copy, which includes ~/.gitconfig.local in turn"
      elif [ -L "$p" ]; then
        target="$(readlink "$p")"
        case "$target" in
          /*) p="$target" ;;
          *) p="$dir/$target" ;;
        esac
        hops_left=$((hops_left - 1))
      else
        break
      fi
    done
    [ -z "$loop" ] || break
  done <<< "$(git_includes "$GITCONFIG_LOCAL")"
  if [ -n "$loop" ]; then
    echo "bootstrap: ~/.gitconfig.local $loop, and the shipped ~/.gitconfig includes ~/.gitconfig.local — git would stop every command on that loop; remove the line" >&2
    refused=yes
  fi
fi
# git sets the identity after ~/.gitconfig has moved onto ~/.gitconfig.local,
# and sets nothing while its lock is there or in a file it cannot parse. Only
# the identity's file is read: git parses its global and system configs before
# any command, and the deploy replaces ~/.gitconfig anyway.
git_local() { GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git config -f "$@"; }   # git_local <file> <git config args…>
if [ -e "$GITCONFIG_LOCAL.lock" ] || [ -L "$GITCONFIG_LOCAL.lock" ]; then
  echo "bootstrap: ~/.gitconfig.local.lock is there — git's lock on ~/.gitconfig.local, held while a git writes that file and left behind by one that stopped mid-write; git sets no key while it is there. If no git is running, delete it" >&2
  refused=yes
fi
if command -v git >/dev/null 2>&1 && ! bare_shim git; then
  if [ -f "$GITCONFIG_LOCAL" ] && [ ! -L "$GITCONFIG_LOCAL" ] && [ -r "$GITCONFIG_LOCAL" ] \
    && ! err="$(git_local "$GITCONFIG_LOCAL" --list 2>&1 >/dev/null)"; then
    echo "bootstrap: git cannot read ~/.gitconfig.local, where the identity is set — $(sed -n 1p <<< "$err")" >&2
    refused=yes
  fi
  # The move below, in == git ==: a plain ~/.gitconfig, no ~/.gitconfig.local,
  # and no mention of it or of the git piece's copy in the file.
  if [ -f "$GITCONFIG" ] && [ ! -L "$GITCONFIG" ] && [ ! -e "$GITCONFIG_LOCAL" ] && [ ! -L "$GITCONFIG_LOCAL" ] \
    && ! grep -q 'gitconfig\.local' "$GITCONFIG" && ! grep -qF "$GIT_PIECE_COPY" "$GITCONFIG" \
    && ! err="$(git_local "$GITCONFIG" --list 2>&1 >/dev/null)"; then
    echo "bootstrap: git cannot read ~/.gitconfig, which this run moves to ~/.gitconfig.local to set the identity there — $(sed -n 1p <<< "$err")" >&2
    refused=yes
  fi
fi
if [ "$HOME" != "$AUTHORED_HOME" ] && grep -q '^tab_title_template ' "$KITTY_CONF" 2>/dev/null \
  && [ -e "$TAB_TITLE_CONF" ] && [ ! -L "$TAB_TITLE_CONF" ] && [ ! -f "$TAB_TITLE_CONF" ]; then
  echo "bootstrap: ~/.config/kitty/tab-title.conf is not a file — this run writes the tab title there" >&2
  refused=yes
fi
# Shown as it happens and kept: preen apply's own lines are the one record of
# what it set aside, and the closing lines name each of those files. Made
# here, so a TMPDIR that cannot hold it stops the run before the moves. A dry
# run sets nothing aside and keeps no log: it asks the directory instead.
log_dir="${TMPDIR:-/tmp}"
if [ "$dry_run" = yes ]; then
  deploy_log=/dev/null
  [ -d "$log_dir" ] && [ -w "$log_dir" ] && [ -x "$log_dir" ] || deploy_log=""
elif deploy_log="$(mktemp "$log_dir/bootstrap.XXXXXX" 2>/dev/null)"; then
  trap 'rm -f "$deploy_log"' EXIT
fi
if [ -z "$deploy_log" ]; then
  echo "bootstrap: could not create the deploy log in $log_dir — point TMPDIR at a directory you can write" >&2
  refused=yes
fi
# Its plan is what a dry run shows under == deploying ==.
apply_plan="$("$REPO/bin/preen" apply --dry-run)" || refused=yes
if [ "$refused" = yes ]; then
  echo "bootstrap: stopped — nothing was changed" >&2
  exit 1
fi

echo "== dependencies =="
# A tool in a Homebrew prefix counts as installed, on this shell's PATH or not:
# the setup's zprofile puts Homebrew on PATH in every login shell.
in_brew() { # in_brew <tool> → true when a Homebrew prefix's bin/ holds <tool>
  local prefix
  # shellcheck disable=SC2086  # BREW_PREFIXES is a list, meant to split
  for prefix in $BREW_PREFIXES; do
    if [ -x "$prefix/bin/$1" ]; then return 0; fi
  done
  return 1
}
# The gate: without one of these the setup is broken, not just smaller. git
# on a Mac without the Command Line Tools is the stub, so it counts as missing.
missing=""
for tool in kitty zsh git starship fzf zoxide eza bat delta; do
  if { ! command -v "$tool" >/dev/null 2>&1 || bare_shim "$tool"; } && ! in_brew "$tool"; then missing="$missing $tool"; fi
done
# These two are Homebrew formulae, not commands on PATH, so `command -v`
# cannot see them. Test the files shell/zshrc sources, under the prefixes it
# looks in — that is the question being asked ("will the shell find it?").
# `brew list` is not asked: it reports an installed formula as missing
# whenever it fails for an unrelated reason (a read-only HOME, say), and it
# populates a ~35 MB API cache in the adopter's ~/Library that nothing here
# announces.
for plugin in zsh-syntax-highlighting zsh-autosuggestions; do
  found=no
  # shellcheck disable=SC2086  # BREW_PREFIXES is a list, meant to split
  for prefix in "${HOMEBREW_PREFIX:-}" $BREW_PREFIXES; do
    if [ -n "$prefix" ] && [ -f "$prefix/share/$plugin/$plugin.zsh" ]; then found=yes; break; fi
  done
  # shell/zshrc also takes the highlighter from a clone, for a host without root.
  if [ "$plugin" = zsh-syntax-highlighting ] && [ -f "$HOME/.zsh/$plugin/$plugin.zsh" ]; then found=yes; fi
  [ "$found" = yes ] || missing="$missing $plugin"
done
# kitty.conf asks for this face; its cask names the files so, and the kitty
# drop-in looks in these same places.
font=no
for f in "$HOME/Library/Fonts/FiraCodeNerdFontMono"* /Library/Fonts/FiraCodeNerdFontMono*; do
  if [ -e "$f" ]; then font=yes; break; fi
done
[ "$font" = yes ] || missing="$missing font-fira-code-nerd-font"

# Everything the shipped files guard: each one's absence costs what it says.
without() { # without <tool> → what goes missing when it is not installed
  case "$1" in
    fd)      echo "the fzf finder falls back to its own walker, which ignores .gitignore" ;;
    rg)      echo "nothing else here needs it — the setup ships only its config" ;;
    atuin)   echo "Ctrl+R stays fzf's history search" ;;
    mise)    echo "no per-directory node or python" ;;
    gh)      echo "nothing else here needs it — the setup ships only its config" ;;
    git-lfs) echo "repositories that use LFS fail to check out" ;;
    tmux)    echo "no tmux over ssh" ;;
    zed)     echo "EDITOR falls back to nano, and kitty's click-to-open does nothing" ;;
  esac
}
optional=""
for tool in fd rg atuin mise gh git-lfs tmux zed; do
  command -v "$tool" >/dev/null 2>&1 || in_brew "$tool" || optional="$optional $tool"
done
# tmux.conf runs tpm from this path, where no package manager puts it.
tpm=yes
[ -x "$HOME/.config/tmux/plugins/tpm/tpm" ] || tpm=no

brew=""
if command -v brew >/dev/null 2>&1; then brew=brew; fi
# shellcheck disable=SC2086
for prefix in $BREW_PREFIXES; do
  if [ -z "$brew" ] && [ -x "$prefix/bin/brew" ]; then brew="$prefix/bin/brew"; fi
done
if [ -n "$brew" ] && [ "$brew" != brew ]; then
  echo "Homebrew is installed ($brew) but not on this shell's PATH; the setup's zprofile puts it there in every new terminal window."
fi
case "${SHELL:-}" in
  ""|*/zsh) ;;
  *) echo "Your login shell is $SHELL, and this setup's shell config is zsh's: chsh -s /bin/zsh" ;;
esac
if [ -z "$brew" ] && [ -n "$missing$optional" ]; then
  brew=brew
  echo "No Homebrew here — install it first, from https://brew.sh; it brings the Command Line Tools too. Then:"
fi
if [ -n "$optional" ] || [ "$tpm" = no ]; then
  echo "Optional, not installed — what goes without each:"
  # shellcheck disable=SC2086
  for tool in $optional; do printf '  %-8s %s\n' "$tool" "$(without "$tool")"; done
  [ "$tpm" = yes ] || printf '  %-8s %s\n' tpm "tmux's plugins: git clone https://github.com/tmux-plugins/tpm ~/.config/tmux/plugins/tpm"
  [ -z "$optional" ] || echo "  $brew install$optional"
fi
if [ -n "$missing" ]; then
  echo "Missing:$missing"
  echo "  $brew install$missing"
  if [ "$dry_run" = yes ]; then
    echo "would ask: Continue anyway? [y/N] — any answer but y or yes stops the run there, nothing changed"
  else
    ask 'Continue anyway? [y/N] ' reply
    case "$reply" in
      [yY]|[yY][eE][sS]) ;;
      *) echo "bootstrap: stopped — nothing was changed. Install what is missing, then run this again." >&2; exit 1 ;;
    esac
  fi
fi

echo
echo "== your details =="
if [ "$dry_run" = yes ]; then
  echo "would ask your full name and email for git commits"
else
  ask_required 'Full name for git commits: ' git_name
  ask_required 'Email for git commits: '     git_email
fi

echo
echo "== git =="
# The shipped gitconfig includes ~/.gitconfig.local last, and git keeps the
# last value it reads, so a gitconfig of the adopter's own belongs there whole —
# ssh's rule below. Left to preen apply it would be kept as a backup, and its
# credential helpers, signing and includeIf would go quiet. One that
# names gitconfig.local would, moved there, include itself, and git stops every
# command on that ("exceeded maximum include depth"). So would one that names
# the git piece's copy, which includes ~/.gitconfig.local. Both are text tests,
# not git's parse: a name in a comment keeps the file too, which errs toward
# keeping it, never toward the loop.
moved=""   # what moves onto its overlay, as ~ paths
if [ -f "$GITCONFIG" ] && [ ! -L "$GITCONFIG" ]; then
  if [ -e "$GITCONFIG_LOCAL" ]; then
    echo "~/.gitconfig.local is there, so ~/.gitconfig is not moved onto it — the deploy below keeps it as ~/.gitconfig.unpreened.<stamp>"
  elif grep -q 'gitconfig\.local' "$GITCONFIG"; then
    echo "~/.gitconfig names gitconfig.local itself — the deploy below keeps it as ~/.gitconfig.unpreened.<stamp>"
  elif grep -qF "$GIT_PIECE_COPY" "$GITCONFIG"; then
    echo "~/.gitconfig names the git piece's copy, ~/$GIT_PIECE_COPY, which includes ~/.gitconfig.local: moved there, it would include itself, and git stops every command on that — the deploy below keeps it as ~/.gitconfig.unpreened.<stamp>"
  else
    run mv "$GITCONFIG" "$GITCONFIG_LOCAL"
    moved="~/.gitconfig"
    echo "$(tell moved 'would move') ~/.gitconfig -> ~/.gitconfig.local — the shipped gitconfig includes it last, so every line of it still wins"
  fi
fi

# The identity is set by key, so the rest of an adopter's file stays as it is,
# and git quotes the value as it needs: written bare, a '#' in a name would
# start a comment. --replace-all collapses a key the file repeats.
if [ "$dry_run" = yes ]; then
  # Nothing moved, so the keys are read where they are now.
  id_file="$GITCONFIG_LOCAL"
  [ -z "$moved" ] || id_file="$GITCONFIG"
  if [ ! -e "$id_file" ]; then
    echo "would write ~/.gitconfig.local, your answers as user.name and user.email"
  elif command -v git >/dev/null 2>&1 && ! bare_shim git; then
    for key in user.name user.email; do
      current="$(git_local "$id_file" --get-all "$key" 2>/dev/null)" || current=""
      case "$current" in
        "")      echo "would set $key in ~/.gitconfig.local to your answer — not set there now" ;;
        *$'\n'*) echo "would set $key in ~/.gitconfig.local to your answer — set there more than once now, each replaced by it" ;;
        *)       echo "would set $key in ~/.gitconfig.local to your answer — now $current, kept if you answer the same" ;;
      esac
    done
  else
    echo "~/.gitconfig.local is there, and git cannot run here to set keys in it — the real run prints the lines to set under [user] there"
  fi
elif command -v git >/dev/null 2>&1 && ! bare_shim git; then
  created=no
  [ -e "$GITCONFIG_LOCAL" ] || created=yes
  set_keys=""
  for key in user.name user.email; do
    if [ "$key" = user.name ]; then value="$git_name"; else value="$git_email"; fi
    current="$(git_local "$GITCONFIG_LOCAL" --get-all "$key" 2>/dev/null)" || current=""
    [ "$current" = "$value" ] && continue
    git_local "$GITCONFIG_LOCAL" --replace-all -- "$key" "$value"
    set_keys="${set_keys:+$set_keys and }$key"
  done
  if [ "$created" = yes ]; then
    echo "wrote ~/.gitconfig.local"
  elif [ -z "$set_keys" ]; then
    echo "unchanged ~/.gitconfig.local"
  else
    echo "set $set_keys in ~/.gitconfig.local — the rest of it is as it was"
  fi
else
  # No git to set a key with: a file of the adopter's is not rewritten by hand.
  # In git's quoting, '\' and '"' take a backslash.
  q_name="${git_name//\\/\\\\}"; q_name="${q_name//\"/\\\"}"
  q_email="${git_email//\\/\\\\}"; q_email="${q_email//\"/\\\"}"
  if [ ! -e "$GITCONFIG_LOCAL" ]; then
    printf '[user]\n\tname = "%s"\n\temail = "%s"\n' "$q_name" "$q_email" > "$GITCONFIG_LOCAL"
    echo "wrote ~/.gitconfig.local"
  else
    echo "~/.gitconfig.local is there, and git cannot run here to set keys in it — under [user] there, set:"
    printf '  name = "%s"\n  email = "%s"\n' "$q_name" "$q_email"
  fi
fi

echo
echo "== ssh =="
# The shipped ssh/config includes ~/.ssh/config.local on its first line, and
# ssh keeps the first value it reads, so a config of the adopter's own belongs
# there whole — the drop-ins' rule: their file becomes the overlay when none
# exists. Left to preen apply it would be kept as a backup, and every host in
# it would go dark until someone moved it by hand. A symlink of theirs
# (a dotfiles repo's) moves as a link: it keeps pointing where it did, and
# nothing is written through it.
SSH_CONF="$HOME/.ssh/config"
SSH_LOCAL="$HOME/.ssh/config.local"
if [ -L "$SSH_CONF" ]; then
  ssh_aside="replaces the link, and the file it points at stays as it is"
else
  ssh_aside="keeps it as ~/.ssh/config.unpreened.<stamp>"
fi
if [ -L "$SSH_CONF" ] && [ "$SSH_CONF" -ef "$REPO/ssh/config" ]; then
  echo "~/.ssh/config is already this setup's"
elif [ -e "$SSH_LOCAL" ] || [ -L "$SSH_LOCAL" ]; then
  if [ -e "$SSH_CONF" ] || [ -L "$SSH_CONF" ]; then
    echo "~/.ssh/config.local is there, so ~/.ssh/config is not moved onto it — the deploy below $ssh_aside"
  else
    echo "~/.ssh/config.local is there — left as it is"
  fi
elif [ -f "$SSH_CONF" ] || [ -L "$SSH_CONF" ]; then
  # A config that names config.local itself would, moved there, include itself.
  if grep -q 'config\.local' "$SSH_CONF" 2>/dev/null; then
    echo "~/.ssh/config names config.local itself — the deploy below $ssh_aside; merge it by hand"
  else
    # A link is read before it moves: within ~/.ssh it points the same after.
    what="— the shipped config includes it first, so every line of it still wins"
    if [ -L "$SSH_CONF" ] && [ -e "$SSH_CONF" ]; then
      what="(a symlink -> $(readlink "$SSH_CONF")) $what"
    elif [ -L "$SSH_CONF" ]; then
      what="(a symlink -> $(readlink "$SSH_CONF"), which points at nothing)"
    fi
    run mv "$SSH_CONF" "$SSH_LOCAL"
    moved="${moved:+$moved }~/.ssh/config"
    echo "$(tell moved 'would move') ~/.ssh/config -> ~/.ssh/config.local $what"
  fi
else
  echo "no ~/.ssh/config of yours — nothing to move"
fi

echo
echo "== deploying =="
if [ "$dry_run" = yes ]; then
  # Its plan is read against the home as it is now, so it would set aside
  # what the moves above take first; the real deploy finds those targets
  # empty. awk drops that line for each moved target, matched whole. Its last
  # lines, `--` and the closing line, are this run's to say, at the end.
  lead="preen apply's plan, read against your home as it is now"
  [ -z "$moved" ] || lead="$lead — less what it would set aside at ${moved// / and }, which the moves above take first"
  echo "$lead:"
  deploy_plan="$(sed '/^--$/,$d' <<< "$apply_plan" | awk -v moved=" $moved " '
    /^would (back up|replace link|move aside) / {
      t = $0; sub(/^would [a-z]+ [a-z]+ +/, "", t); sub(/ (->|\(was ->|\(a symlink ->) .*/, "", t)
      if (index(moved, " " t " ")) next
    }
    { print }')"
  printf '%s\n' "$deploy_plan"
else
  "$REPO/bin/preen" apply | tee "$deploy_log"
fi

echo
echo "== tab title =="
# kitty.conf's tab_title_template collapses the working directory to '~' with
# a Python .replace() inside kitty's own config language, which expands no
# environment variable in this setting — measured against kitty 0.48.2, where
# `${HOME}` in that option comes back verbatim. So the home to collapse must
# be a literal, authored for one machine: AUTHORED_HOME, above.
#
# It is NOT rewritten in the clone: a dirty clone makes `git pull` refuse
# every upstream change, because the deployed gitconfig sets pull.rebase.
# kitty.conf ends with `globinclude tab-title.conf` then `globinclude
# local.conf`, each silent when the file does not exist and last-wins when it
# does. tab-title.conf is this run's, written whole; local.conf is the
# adopter's, read after it, and never written here.
if [ "$HOME" = "$AUTHORED_HOME" ]; then
  echo "this is the home the tab title was authored for — no tab-title.conf needed"
elif [ ! -f "$KITTY_CONF" ]; then
  echo "kitty.conf not found — skipped"
elif [ ! -f "$TAB_TITLE_AWK" ]; then
  echo "tab-title.awk not found — skipped"
else
  # The line is read out of kitty.conf rather than repeated here: two copies
  # of a taste value is the drift this repo exists to close. tab-title.awk
  # says how it is rewritten, for the kitty drop-in too.
  title_line="$(awk -v want=title -v authored="$AUTHORED_HOME" -f "$TAB_TITLE_AWK" "$KITTY_CONF")"
  if [ -z "$title_line" ]; then
    echo "kitty.conf has no tab_title_template line — no tab-title.conf needed" >&2
  else
    run mkdir -p "$(dirname "$TAB_TITLE_CONF")"
    # A file replaced whole is never written through: a symlink here is moved
    # aside, link and all, as preen apply moves one at a copy row. A plain file
    # of one tab_title_template line is this run's own, for another home or an
    # older kitty.conf, and is replaced with no backup, which the doctor would
    # otherwise warn about on every run after. Any other differing file is
    # kept beside itself, as the kitty drop-in keeps one, and the write is
    # then a new file. The lines go to the deploy log too, so the closing lines
    # name the file set aside.
    title_state="$(tell wrote 'would write')"
    if [ -L "$TAB_TITLE_CONF" ] || { [ -e "$TAB_TITLE_CONF" ] && ! cmp -s - "$TAB_TITLE_CONF" <<< "$title_line"; }; then
      if [ ! -L "$TAB_TITLE_CONF" ] && [ -f "$TAB_TITLE_CONF" ] \
        && awk 'NR == 1 { ok = /^tab_title_template / } END { exit !(NR == 1 && ok) }' "$TAB_TITLE_CONF" 2>/dev/null; then
        run rm -f "$TAB_TITLE_CONF"
      else
        bak="$(backup_name "$TAB_TITLE_CONF")"
        if [ -L "$TAB_TITLE_CONF" ]; then
          aside_line="$(tell 'moved aside     ' 'would move aside ')~/.config/kitty/tab-title.conf (a symlink -> $(readlink "$TAB_TITLE_CONF"))"
        else
          aside_line="$(tell 'backed up       ' 'would back up ')~/.config/kitty/tab-title.conf -> ~/.config/kitty/tab-title.conf${bak#"$TAB_TITLE_CONF"}"
        fi
        run mv "$TAB_TITLE_CONF" "$bak"
        echo "$aside_line" | tee -a "$deploy_log"
      fi
    elif [ -f "$TAB_TITLE_CONF" ]; then
      title_state=unchanged
    fi
    if [ "$title_state" != unchanged ] && [ "$dry_run" = no ]; then
      printf '%s\n' "$title_line" > "$TAB_TITLE_CONF"
    fi
    # local.conf, read after tab-title.conf, may set a tab title of its own:
    # tab-title.awk names its line, and the path it collapses when that is not
    # this home. Their file: named, never written.
    local_title="$(LC_ALL=C awk -v want=local -f "$TAB_TITLE_AWK" "$HOME/.config/kitty/local.conf" 2>/dev/null)" || local_title=""
    local_line="${local_title%% *}"; local_path="${local_title#* }"
    # What tab-title.conf's title does is read back off the file, not assumed;
    # a dry run reads the line it would write.
    title_now="$title_line"
    [ "$dry_run" = yes ] || title_now="$(cat "$TAB_TITLE_CONF")"
    home_lit="${HOME//\\/\\\\}"
    if [ -n "$local_path" ]; then
      echo "$title_state ~/.config/kitty/tab-title.conf; ~/.config/kitty/local.conf line $local_line, read after it, sets a tab title that collapses $local_path"
    elif [ -n "$local_title" ]; then
      echo "$title_state ~/.config/kitty/tab-title.conf; ~/.config/kitty/local.conf line $local_line, read after it, sets a tab title"
    elif grep -qF -e "'$home_lit'" -e "\"$home_lit\"" <<< "$title_now"; then
      echo "$title_state ~/.config/kitty/tab-title.conf, whose tab title collapses this home to '~'"
    else
      echo "$title_state ~/.config/kitty/tab-title.conf, whose tab title does not collapse this home"
    fi
  fi
fi

# ── what is the adopter's now ────────────────────────────────────────────────
# Each shipped file read with an overlay, and that overlay: a file the shipped
# one includes, or, for Zed and Sublime Text, the adopter's own file, which the
# editor reads over the shipped one. None is created here. One ~ path a line,
# since Sublime's hold spaces.
SUBLIME_PACKAGES="~/Library/Application Support/Sublime Text/Packages"
OVERLAID="~/.zshenv
~/.zprofile
~/.zshrc
~/.gitconfig
~/.ssh/config
~/.config/tmux/tmux.conf
~/.config/kitty/kitty.conf
~/.config/zed/global_settings.json
$SUBLIME_PACKAGES/preen/Preferences.sublime-settings
$SUBLIME_PACKAGES/preen/Terminus.sublime-settings
$SUBLIME_PACKAGES/preen/Terminus View.sublime-settings"
overlay_of() { # overlay_of <~path> → the overlay read with the shipped file at that path, if there is one
  case "$1" in
    "~/.zshenv"|"~/.zprofile"|"~/.zshrc"|"~/.gitconfig"|"~/.ssh/config") echo "$1.local" ;;
    "~/.config/tmux/tmux.conf"|"~/.config/kitty/kitty.conf") echo "${1%/*}/local.conf" ;;
    "~/.config/zed/global_settings.json") echo "${1%/*}/settings.json" ;;
    "$SUBLIME_PACKAGES/preen/"*.sublime-settings) echo "$SUBLIME_PACKAGES/User/${1##*/}" ;;
  esac
}
echo
echo "== overlays =="
echo "Each is read with a shipped file, and a line of yours there wins over it:"
while IFS= read -r t; do
  ov="$(overlay_of "$t")"
  # Not `${ov/#\~/$HOME}`: bash 5.2 reads an `&` in HOME as the matched `~`.
  case "$ov" in '~'|'~/'*) ov_abs="$HOME${ov#\~}" ;; *) ov_abs="$ov" ;; esac
  if [ -e "$ov_abs" ] || [ -L "$ov_abs" ]; then
    printf '  %-28s yours\n' "$ov"
  else
    # Absent here only in a dry run: the identity writes ~/.gitconfig.local,
    # and a move writes the overlay of what moved.
    case " ~/.gitconfig $moved " in
      *" $t "*) printf '  %-28s yours after the run\n' "$ov" ;;
      *) printf '  %-28s absent — create it for lines of your own\n' "$ov" ;;
    esac
  fi
done <<< "$OVERLAID"

# A piece taken alone copies a shipped file into its own directory and appends
# a line sourcing the copy to the adopter's file — git's piece, a line
# including it — and the copy reads the overlay the same way. The Zed and
# Sublime Text pieces append no line: they copy to the paths the setup links,
# so the link replaces each copy, and preen apply backs up one that differs.
piece_of() { # piece_of <~path> → the piece that wires the file at that path, and the directory of its copies
  case "$1" in
    "~/.zshrc"|"~/.zshenv") echo "shell ~/.config/zsh/preen/" ;;
    "~/.config/tmux/tmux.conf") echo "tmux ~/.config/tmux/preen/" ;;
    "~/.gitconfig") echo "git ~/.config/git/preen/" ;;
  esac
}
# piece_lines <file> <~path> → the numbers of the file's lines that source the
# piece's copy of the file at <~path>, as `3`, `1 and 4` or `1, 2 and 5`: zsh's
# `source` or `.`, or tmux's `source-file` or `source` past its flags, then the
# copy's path, quoted or not, up to a word-initial comment; for git, an include
# or includeIf path, as git_includes reads it, that starts at ~ or / — git
# expands no variable — and ends in the copy's path. A file that is not a
# regular one has none: awk opening a FIFO would wait for a writer.
piece_lines() {
  local piece dir base copy cmds=". source" flags=no
  read -r piece dir <<< "$(piece_of "$2")"
  [ -n "$piece" ] && [ -f "$1" ] || return 0
  base="${2##*/}"; copy="/${dir#\~/}${base#.}"
  if [ "$piece" = git ]; then
    git_includes "$1" | awk -v copy="${copy//./[.]}\$" '
      { v = $0; sub(/^[^\t]*\t/, "", v); c = substr(v, 1, 1) }
      (c == "~" || c == "/") && v ~ copy { sub(/\t.*/, ""); print }'
  else
    [ "$piece" = shell ] || { cmds="source-file source"; flags=yes; }
    awk -v cmds=" $cmds " -v copy="${copy//./[.]}\$" -v flags="$flags" '
      { for (i = 1; i < NF; i++) {
          if ($i ~ /^#/) break
          if (!index(cmds, " " $i " ")) continue
          j = i + 1
          if (flags == "yes") while (j < NF && $j ~ /^-/) j++
          w = $j; gsub("[\"\047;)]", "", w)
          if (w ~ copy) { print NR; break }
        } }' "$1"
  fi 2>/dev/null | awk '{ n[NR] = $0 } END { for (k = 1; k <= NR; k++) printf "%s%s", (k == 1 ? "" : (k == NR ? " and " : ", ")), n[k] }'
}
piece_said() { # piece_said <numbers> <~path> → what those lines of a file at that path source, or include
  local piece dir verb=source
  read -r piece dir <<< "$(piece_of "$2")"
  case "$piece" in git) verb=include ;; esac
  case "$1" in *" "*) printf 'its lines %s %s' "$1" "$verb" ;; *) printf 'its line %s %ss' "$1" "$verb" ;; esac
  printf " the %s piece's copy in %s, which %ss %s" "$piece" "$dir" "$verb" "$(overlay_of "$2")"
}

# The files this run set aside, in preen apply's words (bootstrap's own lines
# use them too). A shell or tmux file's lines go in its overlay, and never a
# line that sources that overlay, nor a piece's line, which sources the piece's
# copy, which sources the overlay: from inside it, either sources the overlay
# until zsh gives up, tmux 3.7c stops on "too many nested files", or tmux 3.4
# hangs as it starts. A gitconfig's lines go in ~/.gitconfig.local by the same
# rule, never one that includes it nor the git piece's line: from inside it,
# either includes it until git stops every command on "exceeded maximum include
# depth". A piece's line is read off the file set aside, still in place in a
# dry run, or the file a link pointed at.
# A dry run has no log: it reads the lines it planned, preen apply's and the
# tab title's, worded as done so the same parse reads them.
if [ "$dry_run" = yes ]; then
  log_lines="$(printf '%s\n%s\n' "$deploy_plan" "${aside_line:-}" | sed -e 's/^would back up  */backed up       /' \
    -e 's/^would move aside  */moved aside     /' -e 's/^would replace link  */replaced link   /')"
else
  log_lines="$(cat "$deploy_log")"
fi
aside=""
pieces_seen=""
while IFS= read -r line; do
  case "$line" in
    "backed up       "*)
      rest="${line#backed up       }"; orig="${rest%% -> *}"
      held="${rest#* -> }"; [ "$dry_run" = no ] || held="$orig"
      what=" -> ${rest#* -> }, which nothing reads now" ;;
    "moved aside     "*)
      rest="${line#moved aside     }"; orig="${rest%% (a symlink -> *}"; target="${rest#* (a symlink -> }"
      held="${target%)}"
      what=" was a symlink to ${target%)}, set aside beside it; nothing reads it now" ;;
    "replaced link   "*)
      rest="${line#replaced link   }"; orig="${rest%% (was -> *}"; target="${rest#* (was -> }"
      held="${target%)}"
      what=" was a symlink to ${target%)}; nothing reads that file now" ;;
    *) continue ;;
  esac
  ov="$(overlay_of "$orig")"
  where=""
  if [ -n "$ov" ]; then where=": lines you want back go in $ov"; fi
  case "$orig" in
    "~/.zshenv"|"~/.zprofile"|"~/.zshrc"|"~/.config/tmux/tmux.conf") where="$where, never one that sources it" ;;
    "~/.gitconfig") where="$where, never one that includes it" ;;
  esac
  # A link's relative target is taken against the link's directory.
  case "$held" in /*|'~'|'~/'*) ;; *) held="${orig%/*}/$held" ;; esac
  case "$held" in '~'|'~/'*) held="$HOME${held#\~}" ;; esac
  nums="$(piece_lines "$held" "$orig")" || nums=""
  if [ -n "$nums" ]; then
    what="$what; $(piece_said "$nums" "$orig")"
    case "$nums" in
      *" "*) where="$where, and never lines $nums" ;;
      *) where="$where, and never line $nums" ;;
    esac
    pieces_seen="$pieces_seen $(piece_of "$orig")"
  fi
  aside="$aside  $orig$what$where"$'\n'
done <<< "$log_lines"
# No row replaces ~/.tmux.conf, and tmux reads it as well as
# ~/.config/tmux/tmux.conf: measured on tmux 3.7c and 3.4, a piece's line there
# still sources the copy after the run. So that line is named, and the copy is
# not called unread. Nor does a row replace ~/.config/git/config, which git
# reads as well as ~/.gitconfig, so a git piece's line there is named the same
# way.
dot_tmux="$(piece_lines "$HOME/.tmux.conf" "~/.config/tmux/tmux.conf")" || dot_tmux=""
xdg_git="$(piece_lines "$HOME/.config/git/config" "~/.gitconfig")" || xdg_git=""
case " $pieces_seen " in
  *" shell "*)
    if [ -d "$HOME/.config/zsh/preen" ]; then
      aside="$aside  ~/.config/zsh/preen/ holds the shell piece's copies, which nothing reads once this setup's files are linked"$'\n'
    fi ;;
esac
case " $pieces_seen " in
  *" tmux "*)
    if [ -d "$HOME/.config/tmux/preen" ] && [ -z "$dot_tmux" ]; then
      aside="$aside  ~/.config/tmux/preen/ holds the tmux piece's copy, which nothing reads once this setup's tmux.conf is linked"$'\n'
    fi ;;
esac
case " $pieces_seen " in
  *" git "*)
    if [ -d "$HOME/.config/git/preen" ] && [ -z "$xdg_git" ]; then
      aside="$aside  ~/.config/git/preen/ holds the git piece's copy, which nothing reads once this setup's gitconfig is linked"$'\n'
    fi ;;
esac
if [ -n "$aside" ]; then
  echo
  echo "== set aside by $(tell 'this run' 'the real run') =="
  printf '%s' "$aside"
fi
if [ -n "$dot_tmux$xdg_git" ]; then
  echo
  echo "== left in place =="
  if [ -n "$dot_tmux" ]; then echo "  ~/.tmux.conf: $(piece_said "$dot_tmux" "~/.config/tmux/tmux.conf")"; fi
  if [ -n "$xdg_git" ]; then echo "  ~/.config/git/config: $(piece_said "$xdg_git" "~/.gitconfig")"; fi
fi

echo
echo "Claude Code's statusline: ~/.config/cship.toml $(tell 'is linked' 'would be linked'), not wired. ./prompt/install.sh, run from this clone, wires ~/.claude/settings.json and leaves the linked configs alone."
echo
if [ "$dry_run" = yes ]; then
  echo "Nothing was written. Drop --dry-run to do it."
else
  echo "Done. Open a new terminal window."
  echo "Verify with: $REPO/bin/preen doctor"
fi
