#!/usr/bin/env bash
# Adopt this setup on a fresh machine.
#
# Asks for the handful of values that are personal, writes them to a local
# overlay, symlinks everything in the manifest into place (dot-apply owns
# that, backups included), and finally writes the one value kitty's config
# language cannot template into ~/.config/kitty/local.conf. Nothing it does
# touches this clone. Never runs as root.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ "$(id -u)" -eq 0 ]; then
  echo "bootstrap: refusing to run as root — this installs user files" >&2
  exit 1
fi

# Answers arrive on plain stdin: this is run from a clone, so stdin is the
# terminal. At end of input `read` returns non-zero and `set -e` stopped the
# script with no word said — a pipe, or `</dev/null`, printed a prompt and
# quit (14-09-2026).
ask() { # ask <prompt> <variable> — the line typed, trimmed, or a stated stop
  local _line
  printf '%s' "$1"
  if ! IFS= read -r _line; then
    printf '\nbootstrap: no answer on stdin — run it from a terminal, in a clone: ./bin/bootstrap\n' >&2
    exit 1
  fi
  # Trimmed, because `  y  ` at a [y/N] prompt used to stop the run: the
  # spaces were kept and the glob missed.
  _line="${_line#"${_line%%[![:space:]]*}"}"
  _line="${_line%"${_line##*[![:space:]]}"}"
  eval "$2=\$_line"
}
ask_required() { # ask_required <prompt> <variable> — re-asks rather than accept a blank
  while :; do
    ask "$1" "$2"
    eval "[ -n \"\$$2\" ]" && return
    # A blank name or email wrote `name = ` into ~/.gitconfig.local and the
    # run reported success; the failure surfaced later as git's "empty ident
    # name (for <>) not allowed", at the adopter's first commit.
    echo "  that cannot be empty — git refuses to commit without it" >&2
  done
}

echo "== dependencies =="
missing=""
for tool in kitty zsh starship fzf zoxide eza bat git; do
  command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
done
# These two are Homebrew formulae, not commands on PATH, so `command -v`
# cannot see them. Test the exact files shell/zshrc sources — that is the
# question being asked ("will the shell find it?"), and it answers correctly
# on a machine whose Homebrew lives elsewhere, where the zshrc would not
# find it either. `brew list` was asked until 14-09-2026: it reports an
# installed formula as missing whenever it fails for an unrelated reason (a
# read-only HOME, say), and it populates a ~35 MB API cache in the adopter's
# ~/Library that nothing here announced.
brew_missing=""
for plugin in zsh-syntax-highlighting zsh-autosuggestions; do
  [ -f "/opt/homebrew/share/$plugin/$plugin.zsh" ] && continue
  # shell/zshrc also takes the highlighter from a clone, for a host without root.
  [ "$plugin" = zsh-syntax-highlighting ] && [ -f "$HOME/.zsh/$plugin/$plugin.zsh" ] && continue
  brew_missing="$brew_missing $plugin"
done
if [ -n "$missing$brew_missing" ]; then
  echo "Missing:$missing$brew_missing"
  echo "On macOS:  brew install${missing}${brew_missing}"
  echo "The font is separate:  brew install --cask font-fira-code-nerd-font"
  if [ -n "$brew_missing" ]; then
    # Say this or the remedy loops: shell/zshrc looks for the two plugins
    # under /opt/homebrew/share by absolute path (the highlighter also under
    # ~/.zsh), so a Homebrew anywhere else installs them somewhere the shell
    # will not look, and this reports them missing again after a successful
    # install.
    echo "Note: shell/zshrc looks for those two under /opt/homebrew/share by absolute path"
    echo "      (the highlighter also as a clone at ~/.zsh/zsh-syntax-highlighting)."
    echo "      On a Homebrew with another prefix, edit those lines to match it."
  fi
  ask 'Continue anyway? [y/N] ' reply
  # `y` alone was the only accepted answer, and anything else left without a
  # word: a capital Y installed nothing and said nothing (14-09-2026).
  case "$reply" in
    [yY]|[yY][eE][sS]) ;;
    *) echo "bootstrap: stopped — nothing was changed. Install what is missing, then run this again." >&2; exit 1 ;;
  esac
fi

echo
echo "== your details =="
ask_required 'Full name for git commits: ' git_name
ask_required 'Email for git commits: '     git_email

# ~/.gitconfig.local is not a manifest row, so neither of dot-apply's backup
# rules covers it — and it is a conventional name across dotfiles setups,
# which made an unconditional `cat >` the likeliest way for this repo to
# destroy something of an adopter's (a signing key, a work identity). Backed
# up like a manifest row now, and only when it would actually change.
GITCONFIG_LOCAL="$HOME/.gitconfig.local"
new_identity="$(printf '[user]\n\tname = %s\n\temail = %s\n' "$git_name" "$git_email")"
if [ -e "$GITCONFIG_LOCAL" ] && [ "$(cat "$GITCONFIG_LOCAL")" = "$new_identity" ]; then
  echo "unchanged ~/.gitconfig.local"
else
  if [ -e "$GITCONFIG_LOCAL" ] || [ -L "$GITCONFIG_LOCAL" ]; then
    backup="$GITCONFIG_LOCAL.pre-dotfiles.$(date +%Y%m%d-%H%M%S)"
    n=1
    while [ -e "$backup" ] || [ -L "$backup" ]; do backup="$GITCONFIG_LOCAL.pre-dotfiles.$(date +%Y%m%d-%H%M%S).$n"; n=$((n + 1)); done
    mv "$GITCONFIG_LOCAL" "$backup"
    echo "backed up ~/.gitconfig.local -> $(basename "$backup")"
  fi
  printf '%s\n' "$new_identity" > "$GITCONFIG_LOCAL"
  echo "wrote ~/.gitconfig.local"
fi

# The shell overlays are optional: the guards in zshenv/zprofile make an
# absent file a no-op, so an adopter with no work split needs neither.
touch "$HOME/.zshenv.local" "$HOME/.zprofile.local"
echo "wrote empty ~/.zshenv.local and ~/.zprofile.local (fill in if needed)"

echo
echo "== ssh =="
# The shipped ssh/config includes ~/.ssh/config.local on its first line, and
# ssh keeps the first value it reads, so a config of the adopter's own belongs
# there whole — the drop-ins' rule: their file becomes the overlay when none
# exists. Left to dot-apply it would be kept as config.pre-dotfiles, and every
# host in it would go dark until someone moved it by hand.
SSH_CONF="$HOME/.ssh/config"
SSH_LOCAL="$HOME/.ssh/config.local"
if [ -e "$SSH_LOCAL" ] || [ -L "$SSH_LOCAL" ]; then
  echo "~/.ssh/config.local is there — left as it is"
elif [ -f "$SSH_CONF" ] && [ ! -L "$SSH_CONF" ]; then
  # A config that names config.local itself would, moved there, include itself.
  if grep -q 'config\.local' "$SSH_CONF"; then
    echo "~/.ssh/config names config.local itself — the deploy below keeps it as ~/.ssh/config.pre-dotfiles; merge it by hand"
  else
    mv "$SSH_CONF" "$SSH_LOCAL"
    echo "moved ~/.ssh/config -> ~/.ssh/config.local — the shipped config includes it first, so every line of it still wins"
  fi
else
  echo "no ~/.ssh/config of yours — nothing to move"
fi

echo
echo "== deploying =="
"$REPO/bin/dot-apply"

echo
echo "== tab-title path =="
# kitty.conf's tab_title_template collapses the working directory to '~' with
# a Python .replace() inside kitty's own config language, which expands no
# environment variable in this setting — measured against kitty 0.48.2, where
# `${HOME}` in that option comes back verbatim. So the home to collapse must
# be a literal, authored for one machine.
#
# It is NOT rewritten in the clone. Doing that left the clone permanently
# dirty, and the deployed gitconfig sets pull.rebase, so `git pull` then
# refused every upstream change with "cannot pull with rebase: You have
# unstaged changes" — found 14-09-2026. kitty.conf ends with
# `globinclude local.conf`, which is silent when the file does not exist and
# last-wins when it does, so the adopter's line goes to ~/.config instead.
AUTHORED_HOME="/Users/gati3478"
KITTY_CONF="$REPO/terminal/kitty/kitty.conf"
LOCAL_CONF="$HOME/.config/kitty/local.conf"
if [ "$HOME" = "$AUTHORED_HOME" ]; then
  echo "this is the machine the tab title was authored for — nothing to write"
elif [ ! -f "$KITTY_CONF" ]; then
  echo "kitty.conf not found — skipped"
else
  # The line is read out of kitty.conf rather than repeated here: two copies
  # of a taste value is the drift this repo exists to close. awk's index and
  # substr match no pattern at all — `sed "s|$AUTHORED_HOME|$HOME|"` built its
  # expression out of $HOME, so a `|` in it became a different command and an
  # `&` became the whole match, silently.
  title_line="$(awk -v old="$AUTHORED_HOME" -v new="$HOME" '
    /^tab_title_template / {
      out = ""; rest = $0
      while ((i = index(rest, old)) > 0) {
        out = out substr(rest, 1, i - 1) new
        rest = substr(rest, i + length(old))
      }
      print out rest
      exit
    }' "$KITTY_CONF")"
  if [ -z "$title_line" ]; then
    echo "kitty.conf has no tab_title_template line — nothing to write" >&2
  else
    mkdir -p "$(dirname "$LOCAL_CONF")"
    {
      echo "# Written by bootstrap. kitty.conf globincludes this file last, so"
      echo "# the line below overrides the one authored for another machine."
      printf '%s\n' "$title_line"
    } > "$LOCAL_CONF"
    # Report what is true, not what was attempted: the sed this replaced
    # printed "patched …" and exited 0 having changed nothing at all.
    if grep -qF "$HOME" "$LOCAL_CONF"; then
      echo "wrote ~/.config/kitty/local.conf — tab titles collapse this HOME to '~'"
    else
      echo "bootstrap: could not write the tab title for this HOME; tabs will show full paths" >&2
    fi
  fi
fi

echo
echo "Done. Open a new terminal window."
echo "Verify with: $REPO/bin/dot-doctor"
