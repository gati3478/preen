// Settings in here override those in "Default/Preferences.sublime-settings",
// and are overridden in turn by syntax-specific settings.
// Preferences.sublime-settings
{
  "font_face": "Fira Code",
  "font_size": 16,
  "font_options": ["dlig"],
  "rulers": [80, 100, 120],
  // Matches how Zed and IDEA render whitespace, as closely as Sublime allows.
  // Zed shows "boundary" (indentation, trailing, tabs, runs of 2+ spaces) and
  // IDEA shows leading+trailing but not inner (IS_INNER_WHITESPACES_SHOWN
  // false). "enclosed" is deliberately OMITTED: Sublime has no "runs of 2 or
  // more" option, so enclosed would also dot every single inter-word space —
  // more aggressive than either of the other two editors. Default was
  // ["selection"], which showed almost nothing.
  "draw_white_space": ["leading", "trailing", "isolated", "all_tabs"],
  "ignored_packages":
  [
		"Vintage",
  ],
  "index_files": true,
  "highlight_line": true,
  "scroll_past_end": true,
  "spell_check": true,
  "trim_trailing_white_space_on_save": true,
  "remember_open_files": true,
  "theme": "ayu-light.sublime-theme",
  // Vendored, not from the gruvbox package — that package is abandoned
  // (last push 04-03-2023) and so is every Sublime alternative. The explicit
  // Packages/User/ path is deliberate: a bare filename would resolve against
  // any package that happens to ship the same name.
  "color_scheme": "Packages/User/gruvbox-light-hard.sublime-color-scheme",
  // A File Icon 4.0 draws through Sublime's file icon themes (Build 4213+),
  // and opens its theme picker at every launch until this key exists.
  "file_icon_theme": "A File Icon.sublime-file-icons",
  "open_files_in_new_window": false,
  "added_words":
  [
		"dev"
  ],
}
